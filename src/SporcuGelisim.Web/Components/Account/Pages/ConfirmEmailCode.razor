@page "/Account/ConfirmEmailCode"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using SporcuGelisim.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IAccountEmailSender AccountEmailSender
@inject IdentityRedirectManager RedirectManager

<PageTitle>E-posta Onayı</PageTitle>

<section class="content-card p-4">
    <div class="page-heading">
        <p class="dashboard-kicker">E-posta Onayı</p>
        <h1>Onay Kodunu Girin</h1>
        <p>Hesap oluşturulurken e-posta adresinize gönderilen 6 haneli kodu girin.</p>
    </div>

    <StatusMessage Message="@message" />

    <EditForm Model="Input" method="post" OnValidSubmit="ConfirmAsync" FormName="confirm-email-code">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" role="alert" />

        <div class="account-form-grid">
            <div>
                <label for="Input.Email" class="form-label">E-posta</label>
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" />
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <div>
                <label for="Input.Code" class="form-label">Onay kodu</label>
                <InputText @bind-Value="Input.Code" id="Input.Code" class="form-control" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
                <ValidationMessage For="() => Input.Code" class="text-danger" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-4">E-postayı Onayla</button>
    </EditForm>

    <div class="email-change-panel mt-4">
        <div class="section-title-row">
            <h2 class="h4">E-postaya ulaşamıyorum</h2>
        </div>
        <p class="form-help">E-posta yanlış girildiyse mevcut e-posta ve şifrenizi yazarak yeni adrese onay kodu gönderebilirsiniz.</p>

        <EditForm Model="ChangeEmailInput" method="post" OnValidSubmit="ChangeEmailAsync" FormName="confirm-email-change-address">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" role="alert" />

            <div class="account-form-grid">
                <div>
                    <label for="ChangeEmailInput.CurrentEmail" class="form-label">Şu an kayıtlı e-posta</label>
                    <InputText @bind-Value="ChangeEmailInput.CurrentEmail" id="ChangeEmailInput.CurrentEmail" class="form-control" autocomplete="username" />
                    <ValidationMessage For="() => ChangeEmailInput.CurrentEmail" class="text-danger" />
                </div>
                <div>
                    <label for="ChangeEmailInput.Password" class="form-label">Şifre</label>
                    <InputText type="password" @bind-Value="ChangeEmailInput.Password" id="ChangeEmailInput.Password" class="form-control" autocomplete="current-password" />
                    <ValidationMessage For="() => ChangeEmailInput.Password" class="text-danger" />
                </div>
                <div>
                    <label for="ChangeEmailInput.NewEmail" class="form-label">Yeni e-posta</label>
                    <InputText @bind-Value="ChangeEmailInput.NewEmail" id="ChangeEmailInput.NewEmail" class="form-control" autocomplete="email" />
                    <ValidationMessage For="() => ChangeEmailInput.NewEmail" class="text-danger" />
                </div>
            </div>

            <button type="submit" class="btn btn-outline-secondary mt-4">Yeni E-postaya Kod Gönder</button>
        </EditForm>
    </div>
</section>

@code {
    private string? message;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromForm(FormName = "confirm-email-code")]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "confirm-email-change-address")]
    private ChangeEmailInputModel ChangeEmailInput { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
        ChangeEmailInput ??= new();
        if (!string.IsNullOrWhiteSpace(Email))
        {
            Input.Email = Email;
            ChangeEmailInput.CurrentEmail = Email;
        }
    }

    private async Task ConfirmAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email.Trim());
        if (user is null)
        {
            message = "Hata: Kullanıcı bulunamadı.";
            return;
        }

        if (await UserManager.IsEmailConfirmedAsync(user))
        {
            RedirectManager.RedirectTo("/Account/Login");
            return;
        }

        var tokenValue = await UserManager.GetAuthenticationTokenAsync(
            user,
            EmailConfirmationCodeStore.LoginProvider,
            EmailConfirmationCodeStore.TokenName);
        if (!EmailConfirmationCodeStore.Verify(user.Id, Input.Code, tokenValue, DateTimeOffset.UtcNow))
        {
            message = "Hata: Onay kodu geçersiz veya süresi dolmuş.";
            return;
        }

        user.EmailConfirmed = true;
        var result = await UserManager.UpdateAsync(user);
        if (!result.Succeeded)
        {
            message = $"Hata: {string.Join(", ", result.Errors.Select(x => x.Description))}";
            return;
        }

        await UserManager.RemoveAuthenticationTokenAsync(
            user,
            EmailConfirmationCodeStore.LoginProvider,
            EmailConfirmationCodeStore.TokenName);
        RedirectManager.RedirectTo("/Account/Login", new() { ["confirmed"] = "1" });
    }

    private async Task ChangeEmailAsync()
    {
        var user = await UserManager.FindByEmailAsync(ChangeEmailInput.CurrentEmail.Trim());
        if (user is null)
        {
            message = "Hata: Kullanıcı bulunamadı.";
            return;
        }

        if (!await UserManager.CheckPasswordAsync(user, ChangeEmailInput.Password))
        {
            message = "Hata: Şifre doğru değil.";
            return;
        }

        if (await UserManager.IsEmailConfirmedAsync(user))
        {
            message = "Hata: Bu hesabın e-postası zaten onaylanmış.";
            return;
        }

        var newEmail = ChangeEmailInput.NewEmail.Trim();
        var existingUser = await UserManager.FindByEmailAsync(newEmail);
        if (existingUser is not null && existingUser.Id != user.Id)
        {
            message = "Hata: Bu e-posta başka bir hesapta kullanılıyor.";
            return;
        }

        var setEmailResult = await UserManager.SetEmailAsync(user, newEmail);
        if (!setEmailResult.Succeeded)
        {
            message = $"Hata: {string.Join(", ", setEmailResult.Errors.Select(x => x.Description))}";
            return;
        }

        var setUserNameResult = await UserManager.SetUserNameAsync(user, newEmail);
        if (!setUserNameResult.Succeeded)
        {
            message = $"Hata: {string.Join(", ", setUserNameResult.Errors.Select(x => x.Description))}";
            return;
        }

        user.EmailConfirmed = false;
        var updateResult = await UserManager.UpdateAsync(user);
        if (!updateResult.Succeeded)
        {
            message = $"Hata: {string.Join(", ", updateResult.Errors.Select(x => x.Description))}";
            return;
        }

        var code = EmailConfirmationCodeStore.GenerateCode();
        await UserManager.SetAuthenticationTokenAsync(
            user,
            EmailConfirmationCodeStore.LoginProvider,
            EmailConfirmationCodeStore.TokenName,
            EmailConfirmationCodeStore.CreateTokenValue(user.Id, code, DateTimeOffset.UtcNow));
        try
        {
            await AccountEmailSender.SendEmailConfirmationCodeAsync(user, newEmail, code);
        }
        catch (AccountEmailSendException exception)
        {
            message = $"Hata: {exception.Message}";
            return;
        }

        Input.Email = newEmail;
        ChangeEmailInput.CurrentEmail = newEmail;
        ChangeEmailInput.Password = "";
        ChangeEmailInput.NewEmail = "";
        message = "Başarılı: Yeni e-posta adresine onay kodu gönderildi.";
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "E-posta zorunludur.")]
        [EmailAddress(ErrorMessage = "Geçerli bir e-posta adresi girin.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Onay kodu zorunludur.")]
        [RegularExpression(@"^\d{6}$", ErrorMessage = "Onay kodu 6 rakam olmalıdır.")]
        public string Code { get; set; } = "";
    }

    private sealed class ChangeEmailInputModel
    {
        [Required(ErrorMessage = "Mevcut e-posta zorunludur.")]
        [EmailAddress(ErrorMessage = "Geçerli bir e-posta adresi girin.")]
        public string CurrentEmail { get; set; } = "";

        [Required(ErrorMessage = "Şifre zorunludur.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Yeni e-posta zorunludur.")]
        [EmailAddress(ErrorMessage = "Geçerli bir e-posta adresi girin.")]
        public string NewEmail { get; set; } = "";
    }
}
