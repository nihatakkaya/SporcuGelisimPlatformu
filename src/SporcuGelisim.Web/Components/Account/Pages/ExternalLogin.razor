@page "/Account/ExternalLogin"

<PageTitle>Harici Giriş</PageTitle>

<section class="content-card p-4">
    <div class="page-heading compact">
        <p class="dashboard-kicker">Hesap</p>
        <h1>Harici giriş kullanılmıyor</h1>
        <p>Bu projede Google, Microsoft veya benzeri harici giriş sağlayıcıları aktif değildir. Lütfen e-posta ve şifrenizle giriş yapın.</p>
    </div>

    <a class="btn btn-primary" href="/Account/Login">Giriş ekranına dön</a>
</section>

@code {
    public const string LoginCallbackAction = "LoginCallback";
}
