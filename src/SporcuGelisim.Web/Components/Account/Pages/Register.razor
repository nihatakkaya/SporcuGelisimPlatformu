@page "/Account/Register"
@attribute [Authorize(Roles = RoleNames.Admin + "," + RoleNames.Coach)]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using SporcuGelisim.Domain.Entities
@using SporcuGelisim.Domain.Enums
@using SporcuGelisim.Infrastructure.Data
@using SporcuGelisim.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole<Guid>> RoleManager
@inject IUserStore<ApplicationUser> UserStore
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Register> Logger

<PageTitle>Kayıt Oluşturma</PageTitle>

<section class="content-card p-4">
    <div class="page-heading">
        <p class="dashboard-kicker">Hesap Yönetimi</p>
        <h1>Kayıt Oluşturma</h1>
        <p>Yetkiniz olan hesap türleri için e-posta ve geçici şifre belirleyerek kullanıcı oluşturun.</p>
    </div>

    <StatusMessage Message="@message" />

    <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" role="alert" />

        <div class="row g-3">
            <div class="col-md-6">
                <label for="Input.FirstName" class="form-label">Ad</label>
                <InputText @bind-Value="Input.FirstName" id="Input.FirstName" class="form-control" autocomplete="given-name" />
                <ValidationMessage For="() => Input.FirstName" class="text-danger" />
            </div>
            <div class="col-md-6">
                <label for="Input.LastName" class="form-label">Soyad</label>
                <InputText @bind-Value="Input.LastName" id="Input.LastName" class="form-control" autocomplete="family-name" />
                <ValidationMessage For="() => Input.LastName" class="text-danger" />
            </div>
            <div class="col-md-6">
                <label for="Input.Email" class="form-label">E-posta</label>
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" placeholder="kullanici@gmail.com" />
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <div class="col-md-6">
                <label for="Input.Role" class="form-label">Hesap türü</label>
                <InputSelect @bind-Value="Input.Role" id="Input.Role" class="form-select">
                    @foreach (var role in AvailableRoleOptions)
                    {
                        <option value="@role.Value">@role.Label</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Input.Role" class="text-danger" />
            </div>
            <div class="col-md-6">
                <label for="Input.Password" class="form-label">Şifre</label>
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" />
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
            <div class="col-md-6">
                <label for="Input.ConfirmPassword" class="form-label">Şifre tekrar</label>
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
        </div>

        <div class="form-help mt-3">
            Şifre en az 6 karakter olmalı; büyük harf, küçük harf, rakam ve sembol içermelidir.
        </div>

        <button type="submit" class="btn btn-primary mt-4">Hesap Oluştur</button>
    </EditForm>
</section>

@code {
    private static readonly IReadOnlyList<RoleOption> AllRoleOptions =
    [
        new(RoleNames.Athlete, "Sporcu"),
        new(RoleNames.Coach, "Antrenör"),
        new(RoleNames.Parent, "Ebeveyn"),
        new(RoleNames.Admin, "Admin")
    ];

    private IReadOnlyList<RoleOption> AvailableRoleOptions = [];
    private Guid? currentUserId;
    private bool isAdmin;
    private bool isCoach;
    private string? message;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        currentUserId = user?.Id;
        isAdmin = authState.User.IsInRole(RoleNames.Admin);
        isCoach = authState.User.IsInRole(RoleNames.Coach);
        AvailableRoleOptions = GetAvailableRoleOptions();
        if (!AvailableRoleOptions.Any(x => x.Value == Input.Role))
        {
            Input.Role = AvailableRoleOptions.FirstOrDefault()?.Value ?? RoleNames.Athlete;
        }
    }

    public async Task RegisterUser()
    {
        message = null;
        AvailableRoleOptions = GetAvailableRoleOptions();
        if (!AvailableRoleOptions.Any(x => x.Value == Input.Role))
        {
            message = "Hata: Bu hesap türünü oluşturma yetkiniz yok.";
            return;
        }

        if (!await RoleManager.RoleExistsAsync(Input.Role))
        {
            var createRole = await RoleManager.CreateAsync(new IdentityRole<Guid>(Input.Role));
            if (!createRole.Succeeded)
            {
                message = $"Hata: Rol oluşturulamadı. {string.Join(", ", createRole.Errors.Select(error => error.Description))}";
                return;
            }
        }

        var user = CreateUser();
        user.FirstName = Input.FirstName.Trim();
        user.LastName = Input.LastName.Trim();
        user.EmailConfirmed = true;

        await UserStore.SetUserNameAsync(user, Input.Email.Trim(), CancellationToken.None);
        var emailStore = GetEmailStore();
        await emailStore.SetEmailAsync(user, Input.Email.Trim(), CancellationToken.None);

        var result = await UserManager.CreateAsync(user, Input.Password);
        if (!result.Succeeded)
        {
            message = $"Hata: {string.Join(", ", result.Errors.Select(error => error.Description))}";
            return;
        }

        var roleResult = await UserManager.AddToRoleAsync(user, Input.Role);
        if (!roleResult.Succeeded)
        {
            message = $"Hata: {string.Join(", ", roleResult.Errors.Select(error => error.Description))}";
            return;
        }

        if (Input.Role == RoleNames.Athlete)
        {
            var profile = new AthleteProfile { UserId = user.Id };
            Db.AthleteProfiles.Add(profile);
            if (isCoach && currentUserId.HasValue)
            {
                Db.AthleteRelations.Add(new AthleteRelation
                {
                    AthleteProfileId = profile.Id,
                    RelatedUserId = currentUserId.Value,
                    RelationType = AthleteRelationType.Coach,
                    CreatedByUserId = currentUserId.Value
                });
            }

            await Db.SaveChangesAsync();
        }

        Logger.LogInformation("{CreatorRole} created a {Role} account.", isAdmin ? RoleNames.Admin : RoleNames.Coach, Input.Role);
        message = $"Başarılı: {Input.Email} için {RoleLabel(Input.Role)} hesabı oluşturuldu.";
        Input = new() { Role = AvailableRoleOptions.FirstOrDefault()?.Value ?? RoleNames.Athlete };
    }

    private IReadOnlyList<RoleOption> GetAvailableRoleOptions()
    {
        if (isAdmin)
        {
            return AllRoleOptions;
        }

        if (isCoach)
        {
            return AllRoleOptions.Where(x => x.Value == RoleNames.Athlete || x.Value == RoleNames.Parent).ToList();
        }

        return [];
    }

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException($"{nameof(ApplicationUser)} örneği oluşturulamadı.");
        }
    }

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException("Kullanıcı deposu e-posta desteği sağlamıyor.");
        }

        return (IUserEmailStore<ApplicationUser>)UserStore;
    }

    private static string RoleLabel(string role) => AllRoleOptions.First(x => x.Value == role).Label;

    private sealed record RoleOption(string Value, string Label);

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Ad zorunludur.")]
        [StringLength(100, ErrorMessage = "Ad en fazla 100 karakter olabilir.")]
        public string FirstName { get; set; } = "";

        [Required(ErrorMessage = "Soyad zorunludur.")]
        [StringLength(100, ErrorMessage = "Soyad en fazla 100 karakter olabilir.")]
        public string LastName { get; set; } = "";

        [Required(ErrorMessage = "E-posta zorunludur.")]
        [EmailAddress(ErrorMessage = "Geçerli bir e-posta adresi girin.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Hesap türü zorunludur.")]
        public string Role { get; set; } = RoleNames.Athlete;

        [Required(ErrorMessage = "Şifre zorunludur.")]
        [StringLength(100, ErrorMessage = "Şifre en az {2}, en fazla {1} karakter olmalıdır.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("Password", ErrorMessage = "Şifre ve tekrar alanı eşleşmiyor.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
