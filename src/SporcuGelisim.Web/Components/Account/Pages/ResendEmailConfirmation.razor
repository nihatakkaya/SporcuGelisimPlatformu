@page "/Account/ResendEmailConfirmation"

@inject NavigationManager Navigation

<PageTitle>E-posta Onayı</PageTitle>

<section class="content-card p-4">
    <div class="page-heading">
        <p class="dashboard-kicker">E-posta Onayı</p>
        <h1>Onay Koduna Yönlendiriliyorsunuz</h1>
        <p>Onay kodu işlemleri artık tek ekrandan yapılır.</p>
    </div>
</section>

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/Account/ConfirmEmailCode", replace: true);
    }
}
