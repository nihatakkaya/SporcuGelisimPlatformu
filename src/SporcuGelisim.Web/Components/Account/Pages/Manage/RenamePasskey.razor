@page "/Account/Manage/RenamePasskey/{Id}"

<PageTitle>Geçiş Anahtarı</PageTitle>

<section class="content-card p-4">
    <div class="page-heading compact">
        <p class="dashboard-kicker">Hesap Güvenliği</p>
        <h1>Geçiş anahtarı düzenleme kullanılmıyor</h1>
        <p>Bu projede geçiş anahtarı ile giriş aktif değildir.</p>
    </div>

    <a class="btn btn-primary" href="/Account/Manage">Hesabıma dön</a>
</section>

@code {
    [Parameter]
    public string? Id { get; set; }
}
