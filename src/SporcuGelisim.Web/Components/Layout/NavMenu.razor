@implements IDisposable

@inject NavigationManager NavigationManager
@inject INotificationService NotificationService

<ul class="navbar-nav ms-auto align-items-lg-center">
    <AuthorizeView>
        <Authorized>
            <li class="nav-item">
                <NavLink class="nav-link" href="/dashboard">Ana Sayfa</NavLink>
            </li>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Roles="@RoleNames.Coach">
        <li class="nav-item">
            <NavLink class="nav-link" href="/athletes">Sporcular</NavLink>
        </li>
    </AuthorizeView>
    <AuthorizeView Roles="@RoleNames.Admin">
        <li class="nav-item">
            <NavLink class="nav-link" href="/admin/users">Kullanıcılar</NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="/admin/branches">Branşlar</NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="/admin/reports">Raporlar</NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="/admin/relations">Sporcu Atama</NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="/Account/Register">Kayıt Oluşturma</NavLink>
        </li>
    </AuthorizeView>
    <AuthorizeView Roles="@RoleNames.Coach">
        <li class="nav-item">
            <NavLink class="nav-link" href="/coach/athletes">Sporcularım</NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link nav-link-with-badge" href="/coach/words">
                Kelime Havuzu
                @if (notificationSummary?.PendingWordRequestCount > 0)
                {
                    <span class="nav-alert-badge">@notificationSummary.PendingWordRequestCount</span>
                }
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="/Account/Register">Kayıt Oluşturma</NavLink>
        </li>
    </AuthorizeView>
    <AuthorizeView Roles="@RoleNames.Athlete">
        <li class="nav-item">
            <NavLink class="nav-link" href="/athlete/sessions">Oturumlarım</NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="/athlete/words">Kelime Havuzum</NavLink>
        </li>
    </AuthorizeView>
    <AuthorizeView Roles="@RoleNames.Parent">
        <li class="nav-item">
            <NavLink class="nav-link" href="/parent/athletes">Sporcularım</NavLink>
        </li>
    </AuthorizeView>
    <AuthorizeView>
        <Authorized>
            <li class="nav-item">
                <NavLink class="nav-link nav-link-with-badge" href="/feedback">
                    Geri Bildirimler
                    @if (!IsFeedbackPage && notificationSummary?.UnreadFeedbackCount > 0)
                    {
                        <span class="nav-alert-badge">@notificationSummary.UnreadFeedbackCount</span>
                    }
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="/Account/Manage">Hesabım</NavLink>
            </li>
            <li class="nav-item">
                <form action="/Account/Logout" method="post" class="logout-form">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="nav-link logout-button">Çıkış</button>
                </form>
            </li>
        </Authorized>
    </AuthorizeView>
</ul>

@code {
    private string? currentUrl;
    private NotificationSummaryDto? notificationSummary;
    private bool disposed;
    private bool IsFeedbackPage => currentUrl?.StartsWith("feedback", StringComparison.OrdinalIgnoreCase) == true;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        notificationSummary = await NotificationService.GetSummaryAsync(CancellationToken.None);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        _ = InvokeAsync(async () =>
        {
            notificationSummary = await NotificationService.GetSummaryAsync(CancellationToken.None);
            if (!disposed)
            {
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        disposed = true;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
