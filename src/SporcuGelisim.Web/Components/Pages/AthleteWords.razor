@page "/athlete/words"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RoleNames.Athlete)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SporcuGelisim.Domain.Entities
@using SporcuGelisim.Domain.Enums
@using SporcuGelisim.Infrastructure.Data
@using SporcuGelisim.Infrastructure.Identity
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Kelime Havuzum</PageTitle>

<section class="page-hero compact-hero">
    <div>
        <p class="dashboard-kicker">Sporcu</p>
        <h1>Kelime Havuzum</h1>
        <p>Antrenörünüzün size atadığı kelimeleri görün ve yeni kelime isteğini sorumlu antrenörünüze gönderin.</p>
    </div>
    <div class="hero-badge">
        <span>Atanmış kelime</span>
        <strong>@assignments.Count</strong>
    </div>
</section>

<div class="report-grid">
    <section class="content-card p-4">
        <div class="section-title-row">
            <h2 class="h4">Kelimelerim</h2>
            <span>@assignments.Count kayıt</span>
        </div>

        @if (assignments.Count == 0)
        {
            <div class="dashboard-empty">
                <strong>Henüz kelime atanmadı.</strong>
                <p>Antrenörünüz kelime atadığında burada görünecek.</p>
            </div>
        }
        else
        {
            <div class="word-chip-list">
                @foreach (var assignment in assignments)
                {
                    <span>@assignment.WordText</span>
                }
            </div>
        }
    </section>

    <section class="content-card p-4">
        <div class="section-title-row">
            <h2 class="h4">Kelime isteği gönder</h2>
            <span>@requests.Count istek</span>
        </div>

        <EditForm Model="input" OnValidSubmit="SubmitAsync" FormName="athlete-word-request">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" role="alert" />

            <div class="mb-3">
                <label class="form-label" for="CoachId">Antrenör</label>
                <InputSelect id="CoachId" class="form-select" @bind-Value="input.TargetCoachUserId">
                    <option value="">Seçiniz</option>
                    @foreach (var coach in coaches)
                    {
                        <option value="@coach.Id">@coach.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="mb-3">
                <label class="form-label" for="WordText">Kelime</label>
                <InputText id="WordText" class="form-control" @bind-Value="input.Text" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="WordNote">Not</label>
                <InputTextArea id="WordNote" class="form-control" rows="3" @bind-Value="input.Note" />
            </div>
            <button class="btn btn-primary" type="submit" disabled="@(athleteProfileId == Guid.Empty || coaches.Count == 0)">İstek Gönder</button>
        </EditForm>

        <StatusMessage Message="@message" />
    </section>
</div>

<section class="content-card p-4 mt-4">
    <div class="section-title-row">
        <h2 class="h4">İsteklerim</h2>
        <span>@requests.Count kayıt</span>
    </div>

    @if (requests.Count == 0)
    {
        <p class="muted-line">Henüz kelime isteği göndermediniz.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle">
                <thead>
                    <tr>
                        <th>Kelime</th>
                        <th>Antrenör</th>
                        <th>Durum</th>
                        <th>Not</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in requests)
                    {
                        <tr>
                            <td><strong>@request.Text</strong></td>
                            <td>@request.CoachName</td>
                            <td><span class="status-pill @StatusClass(request.Status)">@StatusText(request.Status)</span></td>
                            <td>@(request.ReviewNote ?? request.Note)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private WordRequestInput input = new();
    private Guid athleteProfileId;
    private Guid? currentUserId;
    private IReadOnlyList<AssignmentRow> assignments = [];
    private IReadOnlyList<RequestRow> requests = [];
    private IReadOnlyList<CoachOption> coaches = [];
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        currentUserId = user?.Id;
        await LoadAsync();
    }

    private async Task SubmitAsync()
    {
        if (currentUserId is null || athleteProfileId == Guid.Empty)
        {
            message = "Hata: Sporcu profiliniz bulunamadı.";
            return;
        }

        if (!input.TargetCoachUserId.HasValue || !coaches.Any(x => x.Id == input.TargetCoachUserId.Value))
        {
            message = "Hata: Sorumlu antrenör seçin.";
            return;
        }

        var normalized = Normalize(input.Text);
        var pendingExists = await Db.AthleteWordRequests.AnyAsync(x =>
            x.AthleteProfileId == athleteProfileId &&
            x.TargetCoachUserId == input.TargetCoachUserId.Value &&
            x.NormalizedText == normalized &&
            x.Status == WordRequestStatus.Pending,
            CancellationToken.None);
        if (pendingExists)
        {
            message = "Hata: Bu kelime için bekleyen bir isteğiniz zaten var.";
            return;
        }

        Db.AthleteWordRequests.Add(new AthleteWordRequest
        {
            AthleteProfileId = athleteProfileId,
            RequestedByUserId = currentUserId.Value,
            TargetCoachUserId = input.TargetCoachUserId.Value,
            Text = input.Text.Trim(),
            NormalizedText = normalized,
            Note = Clean(input.Note)
        });
        await Db.SaveChangesAsync(CancellationToken.None);

        input = new();
        message = "Başarılı: Kelime isteğiniz antrenörünüze gönderildi.";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (currentUserId is null)
        {
            return;
        }

        athleteProfileId = await Db.AthleteProfiles.AsNoTracking()
            .Where(x => x.UserId == currentUserId.Value)
            .Select(x => x.Id)
            .FirstOrDefaultAsync(CancellationToken.None);
        if (athleteProfileId == Guid.Empty)
        {
            assignments = [];
            requests = [];
            coaches = [];
            return;
        }

        assignments = await (
            from assignment in Db.AthleteWordAssignments.AsNoTracking()
            join word in Db.MotivationWords.AsNoTracking() on assignment.MotivationWordId equals word.Id
            where assignment.AthleteProfileId == athleteProfileId && assignment.IsActive
            orderby word.Text
            select new AssignmentRow(word.Text))
            .ToListAsync(CancellationToken.None);

        coaches = await (
            from relation in Db.AthleteRelations.AsNoTracking()
            join user in Db.Users.AsNoTracking() on relation.RelatedUserId equals user.Id
            where relation.AthleteProfileId == athleteProfileId &&
                  relation.RelationType == AthleteRelationType.Coach &&
                  relation.IsActive
            orderby user.FirstName, user.LastName
            select new CoachOption(user.Id, (user.FirstName + " " + user.LastName).Trim()))
            .ToListAsync(CancellationToken.None);

        requests = await (
            from request in Db.AthleteWordRequests.AsNoTracking()
            join coach in Db.Users.AsNoTracking() on request.TargetCoachUserId equals coach.Id
            where request.RequestedByUserId == currentUserId.Value
            orderby request.CreatedAt descending
            select new RequestRow(
                request.Text,
                (coach.FirstName + " " + coach.LastName).Trim(),
                request.Note,
                request.ReviewNote,
                request.Status))
            .ToListAsync(CancellationToken.None);
    }

    private static string StatusText(WordRequestStatus status) => status switch
    {
        WordRequestStatus.Pending => "Bekliyor",
        WordRequestStatus.Approved => "Onaylandı",
        WordRequestStatus.Rejected => "Reddedildi",
        _ => status.ToString()
    };

    private static string StatusClass(WordRequestStatus status) => status switch
    {
        WordRequestStatus.Approved => "active",
        WordRequestStatus.Rejected => "passive",
        _ => "pending"
    };

    private static string Normalize(string value) =>
        value.Trim().ToUpperInvariant()
            .Replace("İ", "I")
            .Replace("Ğ", "G")
            .Replace("Ü", "U")
            .Replace("Ş", "S")
            .Replace("Ö", "O")
            .Replace("Ç", "C");

    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class WordRequestInput
    {
        [Required(ErrorMessage = "Antrenör seçimi zorunludur.")]
        public Guid? TargetCoachUserId { get; set; }

        [Required(ErrorMessage = "Kelime zorunludur.")]
        [StringLength(120, ErrorMessage = "Kelime en fazla 120 karakter olabilir.")]
        public string Text { get; set; } = string.Empty;

        [StringLength(1000, ErrorMessage = "Not en fazla 1000 karakter olabilir.")]
        public string? Note { get; set; }
    }

    private sealed record AssignmentRow(string WordText);
    private sealed record CoachOption(Guid Id, string Name);
    private sealed record RequestRow(string Text, string CoachName, string? Note, string? ReviewNote, WordRequestStatus Status);
}
