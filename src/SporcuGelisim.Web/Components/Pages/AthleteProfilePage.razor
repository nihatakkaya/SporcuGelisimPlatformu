@page "/athlete/profile"
@attribute [Authorize(Roles = RoleNames.Athlete)]

@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using SporcuGelisim.Domain.Entities
@using SporcuGelisim.Infrastructure.Data
@using SporcuGelisim.Infrastructure.Identity

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IBranchService BranchService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Profilim</PageTitle>

<section class="content-card p-4">
    <div class="page-heading">
        <p class="dashboard-kicker">Sporcu Bilgileri</p>
        <h1>Profilim</h1>
        <p>Hesabınıza ait sporcu bilgilerini tamamlayın. Bu bilgiler antrenör ve yönetim süreçlerinde kullanılır.</p>
    </div>

    <StatusMessage Message="@message" />

    @if (isLoading)
    {
        <div class="dashboard-loading">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Profil yükleniyor...</span>
        </div>
    }
    else
    {
        <form method="post" action="/athlete/profile/update" enctype="multipart/form-data" data-enhance="false">
            <AntiforgeryToken />
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="NationalIdentityNumber" class="form-label">TC kimlik no</label>
                    <input id="NationalIdentityNumber" name="NationalIdentityNumber" class="form-control" maxlength="11" value="@Input.NationalIdentityNumber" />
                </div>
                <div class="col-md-6">
                    <label for="PrimaryBranchId" class="form-label">Spor branşı</label>
                    <select id="PrimaryBranchId" name="PrimaryBranchId" class="form-select">
                        <option value="">Seçiniz</option>
                        @foreach (var branch in branches.Where(x => x.IsActive))
                        {
                            <option value="@branch.Id" selected="@(Input.PrimaryBranchId == branch.Id)">@branch.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="PhoneNumber" class="form-label">Telefon no</label>
                    <input id="PhoneNumber" name="PhoneNumber" class="form-control" value="@Input.PhoneNumber" />
                </div>
                <div class="col-md-6">
                    <label for="SecondaryPhoneNumber" class="form-label">2. telefon numarası</label>
                    <input id="SecondaryPhoneNumber" name="SecondaryPhoneNumber" class="form-control" value="@Input.SecondaryPhoneNumber" />
                </div>
                <div class="col-md-6">
                    <label for="ParentPhoneNumber" class="form-label">Ebeveyn no</label>
                    <input id="ParentPhoneNumber" name="ParentPhoneNumber" class="form-control" value="@Input.ParentPhoneNumber" />
                </div>
                <div class="col-md-6">
                    <label for="BirthDate" class="form-label">Doğum tarihi</label>
                    <input type="date" id="BirthDate" name="BirthDate" class="form-control" value="@Input.BirthDateValue" />
                </div>
                <div class="col-12">
                    <label for="Address" class="form-label">Adres</label>
                    <textarea id="Address" name="Address" class="form-control" rows="3">@Input.Address</textarea>
                </div>
                <div class="col-12">
                    <label for="Biography" class="form-label">Sporcu notu</label>
                    <textarea id="Biography" name="Biography" class="form-control" rows="4">@Input.Biography</textarea>
                </div>
                <div class="col-12">
                    <label for="ProfilePhoto" class="form-label">Görsel</label>
                    <input type="file" id="ProfilePhoto" name="ProfilePhoto" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <div class="form-help mt-2">JPG, PNG veya WEBP yükleyebilirsiniz. En fazla 5 MB.</div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary mt-4">Profili Kaydet</button>
        </form>
    }
</section>

@code {
    private readonly ProfileInput Input = new();
    private IReadOnlyList<BranchDto> branches = [];
    private bool isLoading = true;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        var currentUserId = user?.Id;
        if (currentUserId is null)
        {
            message = "Hata: Profil bilgisi için oturum açmanız gerekir.";
            isLoading = false;
            return;
        }

        SetStatusMessage();
        branches = await BranchService.GetTreeAsync(CancellationToken.None);
        await using var db = await DbFactory.CreateDbContextAsync(CancellationToken.None);
        var profile = await db.AthleteProfiles.FirstOrDefaultAsync(x => x.UserId == currentUserId.Value, CancellationToken.None);
        if (profile is null)
        {
            profile = new AthleteProfile { UserId = currentUserId.Value };
            db.AthleteProfiles.Add(profile);
            await db.SaveChangesAsync(CancellationToken.None);
        }

        Input.PrimaryBranchId = profile.PrimaryBranchId;
        Input.NationalIdentityNumber = profile.NationalIdentityNumber;
        Input.PhoneNumber = profile.PhoneNumber;
        Input.SecondaryPhoneNumber = profile.SecondaryPhoneNumber;
        Input.ParentPhoneNumber = profile.ParentPhoneNumber;
        Input.Address = profile.Address;
        Input.Biography = profile.Biography;
        Input.BirthDate = profile.BirthDate.HasValue ? profile.BirthDate.Value.ToDateTime(TimeOnly.MinValue) : null;
        isLoading = false;
    }

    private void SetStatusMessage()
    {
        var query = new Uri(Navigation.Uri).Query;
        var parameters = QueryHelpers.ParseQuery(query);
        if (parameters.ContainsKey("saved"))
        {
            message = "Başarılı: Profil bilgileriniz kaydedildi.";
        }
        else if (parameters.TryGetValue("error", out var error))
        {
            message = error == "1"
                ? "Hata: Profil kaydedilemedi. Bilgileri kontrol edip tekrar deneyin."
                : $"Hata: {error}";
        }
    }

    private sealed class ProfileInput
    {
        public Guid? PrimaryBranchId { get; set; }
        public string? NationalIdentityNumber { get; set; }
        public string? PhoneNumber { get; set; }
        public string? SecondaryPhoneNumber { get; set; }
        public string? ParentPhoneNumber { get; set; }
        public string? Address { get; set; }
        public string? Biography { get; set; }
        public DateTime? BirthDate { get; set; }
        public string? BirthDateValue => BirthDate?.ToString("yyyy-MM-dd");
    }
}
