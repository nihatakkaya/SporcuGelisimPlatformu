@page "/coach/athletes"
@page "/coach/athletes/{SelectedAthleteId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RoleNames.Coach + "," + RoleNames.Admin)]
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SporcuGelisim.Domain.Enums
@using SporcuGelisim.Infrastructure.Data
@using SporcuGelisim.Infrastructure.Identity
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Sporcularım</PageTitle>

<section class="page-hero compact-hero">
    <div>
        <p class="dashboard-kicker">Antrenör Takibi</p>
        <h1>Sporcularım</h1>
        <p>Size bağlı sporcuları, branşlarını, iletişim bilgilerini, oturumlarını, geri bildirimlerini ve atanmış kelimelerini takip edin.</p>
    </div>
    <div class="hero-badge">
        <span>Toplam sporcu</span>
        <strong>@athletes.Count</strong>
    </div>
</section>

<StatusMessage Message="@message" />

@if (isLoading)
{
    <section class="dashboard-loading" aria-live="polite">
        <div class="spinner-border text-primary" role="status"></div>
        <span>Sporcular yükleniyor...</span>
    </section>
}
else if (athletes.Count == 0)
{
    <section class="content-card p-4">
        <div class="dashboard-empty">
            <strong>Henüz size bağlı sporcu yok.</strong>
            <p>Sporcular ekranından istediğiniz sporcuyu kendi alt biriminize ekleyebilirsiniz.</p>
        </div>
    </section>
}
else
{
    <section class="coach-athlete-layout">
        <aside class="athlete-list-panel">
            <div class="list-toolbar">
                <label for="AthleteSearch">Sporcu ara</label>
                <input id="AthleteSearch" class="form-control" @bind="searchText" @bind:event="oninput" placeholder="Ad, branş veya telefon" />
            </div>

            <div class="athlete-list">
                @foreach (var athlete in FilteredAthletes())
                {
                    var isSelected = selectedAthlete?.Id == athlete.Id;
                    <a class="athlete-list-item @(isSelected ? "selected" : null)" href="@($"/coach/athletes/{athlete.Id}")">
                        @if (!string.IsNullOrWhiteSpace(athlete.ProfilePhotoPath))
                        {
                            <img class="athlete-avatar-image" src="@PhotoUrl(athlete.ProfilePhotoPath)" alt="@DisplayName(athlete)" />
                        }
                        else
                        {
                            <span class="athlete-avatar">@Initials(athlete)</span>
                        }
                        <span>
                            <strong>@DisplayName(athlete)</strong>
                            <small>@DisplayBranch(athlete)</small>
                        </span>
                    </a>
                }
            </div>
        </aside>

        <article class="athlete-detail-panel">
            @if (selectedAthlete is null)
            {
                <div class="dashboard-empty">
                    <strong>Sporcu seçin.</strong>
                    <p>Detayları görmek için soldaki listeden bir sporcu seçin.</p>
                </div>
            }
            else
            {
                <div class="athlete-profile-top">
                    @if (!string.IsNullOrWhiteSpace(selectedAthlete.ProfilePhotoPath))
                    {
                        <img src="@PhotoUrl(selectedAthlete.ProfilePhotoPath)" alt="@DisplayName(selectedAthlete)" />
                    }
                    else
                    {
                        <div class="athlete-photo-placeholder">@Initials(selectedAthlete)</div>
                    }
                    <div>
                        <p class="dashboard-kicker">@DisplayBranch(selectedAthlete)</p>
                        <h2>@DisplayName(selectedAthlete)</h2>
                        <p>@(selectedAthlete.Biography ?? "Sporcu notu henüz girilmemiş.")</p>
                    </div>
                </div>

                @if (!isAdmin)
                {
                    <div class="inline-action-panel stacked-action-panel">
                        <div>
                            <strong>Alt birim işlemleri</strong>
                            <span>Sporcuyu altınızdan çıkarmanız eski geri bildirimleri ve kelime atamalarını silmez.</span>
                        </div>
                        <form method="post" action="/coach/athletes/remove" data-enhance="false">
                            <AntiforgeryToken />
                            <input type="hidden" name="AthleteProfileId" value="@selectedAthlete.Id" />
                            <button class="btn btn-outline-danger" type="submit">Altımdan çıkar</button>
                        </form>
                    </div>

                    <div class="inline-action-panel stacked-action-panel">
                        <div>
                            <strong>Ebeveyn eşleştirme</strong>
                            <span>Bu sporcuyu aktif bir ebeveyn hesabı ile eşleştirin.</span>
                            @if (activeParents.Count > 0)
                            {
                                <small>Mevcut ebeveyn: @string.Join(", ", activeParents.Select(x => x.Name))</small>
                            }
                        </div>
                        <form class="inline-select-form" method="post" action="/coach/athletes/assign-parent" data-enhance="false">
                            <AntiforgeryToken />
                            <input type="hidden" name="AthleteProfileId" value="@selectedAthlete.Id" />
                            <select class="form-select" name="ParentUserId" required>
                                <option value="">Ebeveyn seçin</option>
                                @foreach (var parent in parents)
                                {
                                    <option value="@parent.Id">@parent.Name</option>
                                }
                            </select>
                            <button class="btn btn-primary" type="submit" disabled="@(parents.Count == 0)">Eşleştir</button>
                        </form>
                    </div>
                }

                <div class="detail-stat-grid">
                    <div><span>TC kimlik no</span><strong>@DisplayValue(selectedAthlete.NationalIdentityNumber)</strong></div>
                    <div><span>Telefon</span><strong>@DisplayValue(selectedAthlete.PhoneNumber)</strong></div>
                    <div><span>2. telefon (ebeveyn no)</span><strong>@DisplayValue(selectedAthlete.SecondaryPhoneNumber)</strong></div>
                    <div><span>Doğum tarihi</span><strong>@(selectedAthlete.BirthDate?.ToString("dd.MM.yyyy") ?? "Girilmemiş")</strong></div>
                    <div><span>Yaş</span><strong>@DisplayAge(selectedAthlete.BirthDate)</strong></div>
                    <div><span>Adres</span><strong>@DisplayValue(selectedAthlete.Address)</strong></div>
                </div>

                <div class="detail-sections">
                    <section>
                        <SporcuGelisim.Web.Components.Shared.AthleteSessionSummary AthleteId="selectedAthlete.Id" Count="sessionCount" LastSessionDate="lastSessionDate" />
                    </section>

                    <section>
                        <div class="section-title-row">
                            <h3><a href="@($"/coach/athletes/{selectedAthlete.Id}/words")">Atanmış Kelimeler →</a></h3>
                            <span>@assignedWords.Count kayıt</span>
                        </div>
                        @if (assignedWords.Count == 0)
                        {
                            <p class="muted-line">Bu sporcuya atanmış kelime yok.</p>
                        }
                        else
                        {
                            <div class="word-chip-list">
                                @foreach (var assignment in assignedWords)
                                {
                                    <span>@assignment.WordText</span>
                                }
                            </div>
                        }
                    </section>

                    <section class="wide-section">
                        <div class="section-title-row">
                            <h3>İlişki geçmişi</h3>
                            <span>@relationHistory.Count kayıt</span>
                        </div>
                        @if (relationHistory.Count == 0)
                        {
                            <p class="muted-line">Bu sporcu için görüntüleyebileceğiniz ilişki geçmişi yok.</p>
                        }
                        else
                        {
                            <div class="relation-history-list">
                                @foreach (var relation in relationHistory)
                                {
                                    <article class="relation-history-item @(relation.IsActive ? "active" : "passive")">
                                        <span class="status-pill @(relation.IsActive ? "active" : "passive")">@(relation.IsActive ? "Aktif" : "Pasif")</span>
                                        <div>
                                            <strong>@relation.RelatedUserName</strong>
                                            <span>@RelationTypeText(relation.RelationType)</span>
                                            <small>@relation.StartDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm") - @(relation.EndDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Devam ediyor")</small>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </section>

                    <section class="wide-section">
                        <div class="section-title-row">
                            <h3>Geri Bildirimler</h3>
                            <span>@feedbacks.Count kayıt</span>
                        </div>
                        @if (feedbacks.Count == 0)
                        {
                            <p class="muted-line">Bu sporcu için görüntüleyebileceğiniz geri bildirim yok.</p>
                        }
                        else
                        {
                            <div class="compact-list">
                                @foreach (var feedback in feedbacks.Take(4))
                                {
                                    <div>
                                        <strong>@feedback.FeedbackDate.ToLocalTime().ToString("dd.MM.yyyy")</strong>
                                        <span>@feedback.Comment</span>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                </div>
            }
        </article>
    </section>
}

@code {
    [Parameter]
    public Guid? SelectedAthleteId { get; set; }

    private IReadOnlyList<AthleteRow> athletes = [];
    private int sessionCount;
    private DateTimeOffset? lastSessionDate;
    private IReadOnlyList<FeedbackRow> feedbacks = [];
    private IReadOnlyList<AssignmentRow> allAssignments = [];
    private IReadOnlyList<AssignmentRow> assignedWords = [];
    private IReadOnlyList<UserOption> parents = [];
    private IReadOnlyList<ParentRow> activeParents = [];
    private IReadOnlyList<RelationHistoryRow> relationHistory = [];
    private AthleteRow? selectedAthlete;
    private Guid? currentUserId;
    private bool isAdmin;
    private bool isLoading = true;
    private string? searchText;
    private string? message;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        SetMessage();
        await SetCurrentUserAsync();
        parents = await LoadParentsAsync();
        athletes = await LoadAthletesAsync();
        allAssignments = await LoadAssignmentsAsync();

        var selectedId = SelectedAthleteId ?? athletes.FirstOrDefault()?.Id;
        if (selectedId.HasValue && athletes.Any(x => x.Id == selectedId.Value))
        {
            await LoadSelectedAsync(selectedId.Value);
        }
        else
        {
            selectedAthlete = null;
            sessionCount = 0;
            lastSessionDate = null;
            feedbacks = [];
            assignedWords = [];
            activeParents = [];
            relationHistory = [];
        }

        isLoading = false;
    }

    private void SetMessage()
    {
        var query = new Uri(Navigation.Uri).Query;
        if (query.Contains("coachRemoved=1", StringComparison.OrdinalIgnoreCase))
        {
            message = "Başarılı: Sporcu alt biriminizden çıkarıldı.";
        }
        else if (query.Contains("parentAssigned=1", StringComparison.OrdinalIgnoreCase))
        {
            message = "Başarılı: Ebeveyn eşleştirmesi yapıldı.";
        }
        else if (query.Contains("coachMissing=1", StringComparison.OrdinalIgnoreCase))
        {
            message = "Hata: Aktif sporcu ilişkisi bulunamadı.";
        }
        else if (query.Contains("parentMissing=1", StringComparison.OrdinalIgnoreCase))
        {
            message = "Hata: Ebeveyn seçimi zorunludur.";
        }
        else if (query.Contains("parentInvalid=1", StringComparison.OrdinalIgnoreCase))
        {
            message = "Hata: Seçilen ebeveyn hesabı geçersiz.";
        }
        else
        {
            message = null;
        }
    }

    private async Task SetCurrentUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        currentUserId = user?.Id;
        isAdmin = authState.User.IsInRole(RoleNames.Admin);
    }

    private async Task<IReadOnlyList<UserOption>> LoadParentsAsync() =>
        await (
            from user in Db.Users.AsNoTracking()
            join userRole in Db.UserRoles.AsNoTracking() on user.Id equals userRole.UserId
            join role in Db.Roles.AsNoTracking() on userRole.RoleId equals role.Id
            where role.Name == RoleNames.Parent && user.IsActive
            orderby user.FirstName, user.LastName
            select new UserOption(user.Id, (user.FirstName + " " + user.LastName).Trim()))
            .ToListAsync(CancellationToken.None);

    private async Task<IReadOnlyList<AthleteRow>> LoadAthletesAsync()
    {
        if (currentUserId is null)
        {
            return [];
        }

        var query =
            from profile in Db.AthleteProfiles.AsNoTracking()
            join user in Db.Users.AsNoTracking() on profile.UserId equals user.Id
            join branch in Db.SportBranches.AsNoTracking() on profile.PrimaryBranchId equals branch.Id into branchJoin
            from branch in branchJoin.DefaultIfEmpty()
            join photoAsset in Db.FileAssets.AsNoTracking() on user.ProfilePhotoId equals photoAsset.Id into photoJoin
            from photo in photoJoin.DefaultIfEmpty()
            select new { profile, user, branch, photo };

        if (!isAdmin)
        {
            query =
                from row in query
                join relation in Db.AthleteRelations.AsNoTracking() on row.profile.Id equals relation.AthleteProfileId
                where relation.RelatedUserId == currentUserId &&
                      relation.RelationType == AthleteRelationType.Coach &&
                      relation.IsActive
                select row;
        }

        return await query
            .OrderBy(x => x.user.FirstName)
            .ThenBy(x => x.user.LastName)
            .Select(x => new AthleteRow(
                x.profile.Id,
                x.profile.UserId,
                (x.user.FirstName + " " + x.user.LastName).Trim(),
                x.branch == null ? null : x.branch.Name,
                x.profile.NationalIdentityNumber,
                x.profile.PhoneNumber,
                x.profile.SecondaryPhoneNumber,
                x.profile.ParentPhoneNumber,
                x.profile.Address,
                x.profile.Biography,
                x.profile.BirthDate,
                x.photo == null ? null : x.photo.RelativePath))
            .ToListAsync(CancellationToken.None);
    }

    private async Task<IReadOnlyList<AssignmentRow>> LoadAssignmentsAsync()
    {
        var athleteIds = athletes.Select(x => x.Id).ToHashSet();
        return await (
            from assignment in Db.AthleteWordAssignments.AsNoTracking()
            join word in Db.MotivationWords.AsNoTracking() on assignment.MotivationWordId equals word.Id
            where assignment.IsActive && athleteIds.Contains(assignment.AthleteProfileId)
            orderby word.Text
            select new AssignmentRow(assignment.Id, assignment.AthleteProfileId, word.Text))
            .ToListAsync(CancellationToken.None);
    }

    private async Task LoadSelectedAsync(Guid athleteId)
    {
        selectedAthlete = athletes.FirstOrDefault(x => x.Id == athleteId);
        var athleteSessions = Db.AthleteSessions.AsNoTracking().Where(x => x.AthleteProfileId == athleteId);
        sessionCount = await athleteSessions.CountAsync();
        lastSessionDate = await athleteSessions.OrderByDescending(x => x.SessionNumber)
            .Select(x => (DateTimeOffset?)x.SessionDate).FirstOrDefaultAsync();
        feedbacks = await Db.Feedbacks.AsNoTracking()
            .Where(x => x.AthleteProfileId == athleteId && (isAdmin || x.AuthorUserId == currentUserId || x.RecipientUserId == currentUserId))
            .OrderByDescending(x => x.FeedbackDate)
            .Select(x => new FeedbackRow(x.FeedbackDate, x.Comment))
            .ToListAsync(CancellationToken.None);

        assignedWords = allAssignments.Where(x => x.AthleteProfileId == athleteId).ToList();
        activeParents = await (
            from relation in Db.AthleteRelations.AsNoTracking()
            join parent in Db.Users.AsNoTracking() on relation.RelatedUserId equals parent.Id
            where relation.AthleteProfileId == athleteId &&
                  relation.RelationType == AthleteRelationType.Parent &&
                  relation.IsActive
            orderby parent.FirstName, parent.LastName
            select new ParentRow(parent.Id, (parent.FirstName + " " + parent.LastName).Trim()))
            .ToListAsync(CancellationToken.None);

        relationHistory = await (
            from relation in Db.AthleteRelations.AsNoTracking()
            join relatedUser in Db.Users.AsNoTracking() on relation.RelatedUserId equals relatedUser.Id
            where relation.AthleteProfileId == athleteId &&
                  (isAdmin || relation.RelatedUserId == currentUserId)
            orderby relation.IsActive descending, relation.StartDate descending
            select new RelationHistoryRow(
                (relatedUser.FirstName + " " + relatedUser.LastName).Trim(),
                relation.RelationType,
                relation.StartDate,
                relation.EndDate,
                relation.IsActive))
            .ToListAsync(CancellationToken.None);
    }

    private IEnumerable<AthleteRow> FilteredAthletes() =>
        string.IsNullOrWhiteSpace(searchText)
            ? athletes
            : athletes.Where(x =>
                Contains(x.FullName, searchText) ||
                Contains(x.BranchName, searchText) ||
                Contains(x.PhoneNumber, searchText) ||
                Contains(x.SecondaryPhoneNumber, searchText));

    private static bool Contains(string? value, string query) =>
        value?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;

    private static string DisplayName(AthleteRow athlete) =>
        string.IsNullOrWhiteSpace(athlete.FullName) ? "İsimsiz sporcu" : athlete.FullName;

    private static string DisplayBranch(AthleteRow athlete) =>
        string.IsNullOrWhiteSpace(athlete.BranchName) ? "Branş girilmemiş" : athlete.BranchName;

    private static string DisplayValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Girilmemiş" : value;

    private static string DisplayAge(DateOnly? birthDate)
    {
        if (!birthDate.HasValue)
        {
            return "Girilmemiş";
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - birthDate.Value.Year;
        if (birthDate.Value > today.AddYears(-age))
        {
            age--;
        }

        return $"{age} yaşında";
    }

    private static string Initials(AthleteRow athlete)
    {
        var parts = DisplayName(athlete).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(x => x[0])).ToUpperInvariant();
    }

    private static string PhotoUrl(string path) =>
        path.StartsWith("/", StringComparison.Ordinal) ? path : $"/{path.Replace('\\', '/')}";

private static string RelationTypeText(AthleteRelationType relationType) => relationType switch
    {
        AthleteRelationType.Coach => "Antrenör ilişkisi",
        AthleteRelationType.Parent => "Ebeveyn ilişkisi",
        _ => relationType.ToString()
    };

    private sealed record AthleteRow(
        Guid Id,
        Guid UserId,
        string? FullName,
        string? BranchName,
        string? NationalIdentityNumber,
        string? PhoneNumber,
        string? SecondaryPhoneNumber,
        string? ParentPhoneNumber,
        string? Address,
        string? Biography,
        DateOnly? BirthDate,
        string? ProfilePhotoPath);

    private sealed record FeedbackRow(DateTimeOffset FeedbackDate, string Comment);
    private sealed record AssignmentRow(Guid Id, Guid AthleteProfileId, string WordText);
    private sealed record UserOption(Guid Id, string Name);
    private sealed record ParentRow(Guid Id, string Name);
    private sealed record RelationHistoryRow(string RelatedUserName, AthleteRelationType RelationType, DateTimeOffset StartDate, DateTimeOffset? EndDate, bool IsActive);
}
