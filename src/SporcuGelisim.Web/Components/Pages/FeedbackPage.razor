@page "/feedback"
@attribute [Authorize]
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using SporcuGelisim.Domain.Enums
@using SporcuGelisim.Infrastructure.Data
@inject ApplicationDbContext Db
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Geri Bildirimler</PageTitle>

<section class="page-hero compact-hero">
    <div>
        <p class="dashboard-kicker">Geri Bildirim</p>
        <h1>Geri Bildirimler</h1>
        <p>Sporcular sorumlu antrenörlerine mesaj gönderebilir. Antrenör ve ebeveyn mesajları yalnızca gönderen ve alıcı tarafından görülür.</p>
    </div>
</section>

<AuthorizeView Roles="@RoleNames.Athlete">
    <section class="content-card p-4">
        <div class="page-heading compact">
            <h2>Antrenöre geri bildirim gönder</h2>
        </div>

        <form method="post" action="/feedback/send" data-enhance="false">
            <AntiforgeryToken />
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label" for="CoachId">Antrenör</label>
                    <select id="CoachId" name="CoachUserId" class="form-select" required>
                        <option value="">Seçiniz</option>
                        @foreach (var coach in coaches)
                        {
                            <option value="@coach.Id">@coach.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-7">
                    <label class="form-label" for="Comment">Mesaj</label>
                    <textarea id="Comment" name="Comment" class="form-control" rows="4" maxlength="2000" required></textarea>
                </div>
            </div>

            <button class="btn btn-primary mt-3" type="submit" disabled="@(athleteProfileId == Guid.Empty || coaches.Count == 0)">Gönder</button>
        </form>

        @if (coaches.Count > 0)
        {
            <div class="contact-card-grid mt-4">
                @foreach (var coach in coaches)
                {
                    <article class="contact-card">
                        @if (!string.IsNullOrWhiteSpace(coach.PhotoPath))
                        {
                            <img src="@PhotoUrl(coach.PhotoPath)" alt="@coach.Name" />
                        }
                        else
                        {
                            <span>@Initials(coach.Name)</span>
                        }
                        <div>
                            <strong>@coach.Name</strong>
                            <small>@DisplayPhone(coach.PhoneNumber)</small>
                        </div>
                    </article>
                }
            </div>
        }

        <StatusMessage Message="@message" />
    </section>
</AuthorizeView>

<AuthorizeView Roles="@($"{RoleNames.Coach},{RoleNames.Parent}")">
    <section class="content-card p-4 mt-4">
        <div class="page-heading compact">
            <h2>@(isCoach ? "Ebeveyne geri bildirim gönder" : "Antrenöre geri bildirim gönder")</h2>
            <p>Mesaj, seçtiğiniz sporcu üzerinden yalnızca siz ve alıcı hesap arasında görünür.</p>
        </div>

        <form method="post" action="/feedback/send-related" data-enhance="false">
            <AntiforgeryToken />
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label" for="RelatedTarget">Sporcu ve alıcı</label>
                    <select id="RelatedTarget" name="Target" class="form-select" required>
                        <option value="">Seçiniz</option>
                        @foreach (var target in relatedTargets)
                        {
                            <option value="@($"{target.AthleteProfileId}:{target.RecipientUserId}")">@target.AthleteName - @target.RecipientName</option>
                        }
                    </select>
                </div>
                <div class="col-md-7">
                    <label class="form-label" for="RelatedComment">Mesaj</label>
                    <textarea id="RelatedComment" name="Comment" class="form-control" rows="4" maxlength="2000" required></textarea>
                </div>
            </div>

            <button class="btn btn-primary mt-3" type="submit" disabled="@(relatedTargets.Count == 0)">Gönder</button>
        </form>

        <StatusMessage Message="@message" />
    </section>
</AuthorizeView>

<section class="content-card p-4 mt-4">
    <div class="section-title-row">
        <h2 class="h4">Mesajlar</h2>
        <span>@feedbackRows.Count kayıt</span>
    </div>

    @if (feedbackRows.Count == 0)
    {
        <div class="dashboard-empty">
            <strong>Henüz geri bildirim yok.</strong>
            <p>Mesaj gönderildiğinde veya size mesaj geldiğinde burada görüntülenir.</p>
        </div>
    }
    else
    {
        <div class="compact-list">
            @foreach (var row in feedbackRows)
            {
                <div>
                    <strong>@row.AthleteName</strong>
                    <span>@row.AuthorName → @row.RecipientName</span>
                    <span>@row.Date.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                    <span>@row.Comment</span>
                </div>
            }
        </div>
    }
</section>

@code {
    private Guid athleteProfileId;
    private IReadOnlyList<CoachContactOption> coaches = [];
    private IReadOnlyList<RelatedFeedbackTarget> relatedTargets = [];
    private IReadOnlyList<FeedbackRow> feedbackRows = [];
    private bool isCoach;
    private bool isParent;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        SetStatusMessage();
        await LoadAsync();
    }

    private void SetStatusMessage()
    {
        var parameters = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (parameters.ContainsKey("sent"))
        {
            message = "Başarılı: Geri bildiriminiz gönderildi.";
        }
        else if (parameters.TryGetValue("error", out var error))
        {
            message = $"Hata: {error}";
        }
    }

    private async Task LoadAsync()
    {
        if (CurrentUser.UserId is null)
        {
            return;
        }

        var currentUserId = CurrentUser.UserId.Value;
        isCoach = CurrentUser.Roles.Contains(RoleNames.Coach);
        isParent = CurrentUser.Roles.Contains(RoleNames.Parent);

        if (CurrentUser.Roles.Contains(RoleNames.Athlete))
        {
            athleteProfileId = await Db.AthleteProfiles.AsNoTracking()
                .Where(x => x.UserId == currentUserId)
                .Select(x => x.Id)
                .FirstOrDefaultAsync(CancellationToken.None);

            coaches = await (
                from relation in Db.AthleteRelations.AsNoTracking()
                join user in Db.Users.AsNoTracking() on relation.RelatedUserId equals user.Id
                join photo in Db.FileAssets.AsNoTracking() on user.ProfilePhotoId equals photo.Id into photoJoin
                from photo in photoJoin.DefaultIfEmpty()
                where relation.AthleteProfileId == athleteProfileId &&
                      relation.RelationType == AthleteRelationType.Coach &&
                      relation.IsActive
                orderby user.FirstName, user.LastName
                select new CoachContactOption(
                    user.Id,
                    (user.FirstName + " " + user.LastName).Trim(),
                    user.PhoneNumber,
                    photo == null ? null : photo.RelativePath))
                .ToListAsync(CancellationToken.None);
        }

        if (isCoach || isParent)
        {
            relatedTargets = await LoadRelatedTargetsAsync(currentUserId, isCoach);
        }

        var isAdmin = CurrentUser.Roles.Contains(RoleNames.Admin);
        feedbackRows = await (
            from feedback in Db.Feedbacks.AsNoTracking()
            join profile in Db.AthleteProfiles.AsNoTracking() on feedback.AthleteProfileId equals profile.Id
            join athleteUser in Db.Users.AsNoTracking() on profile.UserId equals athleteUser.Id
            join authorUser in Db.Users.AsNoTracking() on feedback.AuthorUserId equals authorUser.Id
            join recipientUser in Db.Users.AsNoTracking() on feedback.RecipientUserId equals recipientUser.Id into recipientJoin
            from recipient in recipientJoin.DefaultIfEmpty()
            where isAdmin ||
                  feedback.AuthorUserId == currentUserId ||
                  feedback.RecipientUserId == currentUserId
            orderby feedback.FeedbackDate descending
            select new FeedbackRow(
                (athleteUser.FirstName + " " + athleteUser.LastName).Trim(),
                (authorUser.FirstName + " " + authorUser.LastName).Trim(),
                recipient == null ? "Genel" : (recipient.FirstName + " " + recipient.LastName).Trim(),
                feedback.FeedbackDate,
                feedback.Comment))
            .ToListAsync(CancellationToken.None);
    }

    private async Task<IReadOnlyList<RelatedFeedbackTarget>> LoadRelatedTargetsAsync(Guid currentUserId, bool currentUserIsCoach)
    {
        var currentRelationType = currentUserIsCoach ? AthleteRelationType.Coach : AthleteRelationType.Parent;
        var targetRelationType = currentUserIsCoach ? AthleteRelationType.Parent : AthleteRelationType.Coach;

        return await (
            from currentRelation in Db.AthleteRelations.AsNoTracking()
            join targetRelation in Db.AthleteRelations.AsNoTracking() on currentRelation.AthleteProfileId equals targetRelation.AthleteProfileId
            join profile in Db.AthleteProfiles.AsNoTracking() on currentRelation.AthleteProfileId equals profile.Id
            join athleteUser in Db.Users.AsNoTracking() on profile.UserId equals athleteUser.Id
            join recipient in Db.Users.AsNoTracking() on targetRelation.RelatedUserId equals recipient.Id
            where currentRelation.RelatedUserId == currentUserId &&
                  currentRelation.RelationType == currentRelationType &&
                  currentRelation.IsActive &&
                  targetRelation.RelationType == targetRelationType &&
                  targetRelation.IsActive &&
                  recipient.IsActive
            orderby athleteUser.FirstName, athleteUser.LastName, recipient.FirstName, recipient.LastName
            select new RelatedFeedbackTarget(
                profile.Id,
                (athleteUser.FirstName + " " + athleteUser.LastName).Trim(),
                recipient.Id,
                (recipient.FirstName + " " + recipient.LastName).Trim()))
            .ToListAsync(CancellationToken.None);
    }

    private static string DisplayPhone(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Telefon girilmemiş" : value;

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(x => x[0])).ToUpperInvariant();
    }

    private static string PhotoUrl(string path) =>
        path.StartsWith("/", StringComparison.Ordinal) ? path : $"/{path.Replace('\\', '/')}";

    private sealed record CoachContactOption(Guid Id, string Name, string? PhoneNumber, string? PhotoPath);
    private sealed record RelatedFeedbackTarget(Guid AthleteProfileId, string AthleteName, Guid RecipientUserId, string RecipientName);
    private sealed record FeedbackRow(string AthleteName, string AuthorName, string RecipientName, DateTimeOffset Date, string Comment);
}
