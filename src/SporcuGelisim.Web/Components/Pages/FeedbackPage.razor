@page "/feedback"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using SporcuGelisim.Domain.Enums
@using SporcuGelisim.Infrastructure.Data

@inject ApplicationDbContext Db
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation

<PageTitle>Geri Bildirimler</PageTitle>

<section class="page-hero compact-hero">
    <div>
        <p class="dashboard-kicker">Geri Bildirim</p>
        <h1>Geri Bildirimler</h1>
        <p>Sporcular sorumlu antrenörlerine mesaj gönderebilir. Antrenör ve ebeveyn mesajları yalnızca gönderen ve alıcı tarafından görünür.</p>
    </div>
</section>

<AuthorizeView Roles="@RoleNames.Athlete">
    <section class="content-card p-4">
        <div class="page-heading compact">
            <h2>Antrenöre geri bildirim gönder</h2>
        </div>

        <form method="post" action="/feedback/send" data-enhance="false">
            <AntiforgeryToken />
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label" for="CoachId">Antrenör</label>
                    <select id="CoachId" name="CoachUserId" class="form-select" required>
                        <option value="">Seçiniz</option>
                        @foreach (var coach in coaches)
                        {
                            <option value="@coach.Id">@coach.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-7">
                    <label class="form-label" for="Comment">Mesaj</label>
                    <textarea id="Comment" name="Comment" class="form-control" rows="4" maxlength="2000" required></textarea>
                </div>
            </div>

            <button class="btn btn-primary mt-3" type="submit" disabled="@(athleteProfileId == Guid.Empty || coaches.Count == 0)">Gönder</button>
        </form>

        @if (coaches.Count > 0)
        {
            <div class="contact-card-grid mt-4">
                @foreach (var coach in coaches)
                {
                    <article class="contact-card">
                        @if (!string.IsNullOrWhiteSpace(coach.PhotoPath))
                        {
                            <img src="@PhotoUrl(coach.PhotoPath)" alt="@coach.Name" />
                        }
                        else
                        {
                            <span>@Initials(coach.Name)</span>
                        }
                        <div>
                            <strong>@coach.Name</strong>
                            <small>@DisplayPhone(coach.PhoneNumber)</small>
                        </div>
                    </article>
                }
            </div>
        }

        <StatusMessage Message="@message" />
    </section>
</AuthorizeView>

<AuthorizeView Roles="@($"{RoleNames.Coach},{RoleNames.Parent}")">
    <section class="content-card p-4 mt-4">
        <div class="page-heading compact">
            <h2>@(isCoach ? "Ebeveyne geri bildirim gönder" : "Antrenöre geri bildirim gönder")</h2>
            <p>Mesaj, seçtiğiniz sporcu üzerinden yalnızca siz ve alıcı hesap arasında görünür.</p>
        </div>

        <form method="post" action="/feedback/send-related" data-enhance="false">
            <AntiforgeryToken />
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label" for="RelatedTarget">Sporcu ve alıcı</label>
                    <select id="RelatedTarget" name="Target" class="form-select" required>
                        <option value="">Seçiniz</option>
                        @foreach (var target in relatedTargets)
                        {
                            <option value="@($"{target.AthleteProfileId}:{target.RecipientUserId}")">@target.AthleteName - @target.RecipientName</option>
                        }
                    </select>
                </div>
                <div class="col-md-7">
                    <label class="form-label" for="RelatedComment">Mesaj</label>
                    <textarea id="RelatedComment" name="Comment" class="form-control" rows="4" maxlength="2000" required></textarea>
                </div>
            </div>

            <button class="btn btn-primary mt-3" type="submit" disabled="@(relatedTargets.Count == 0)">Gönder</button>
        </form>

        <StatusMessage Message="@message" />
    </section>
</AuthorizeView>

<section class="content-card p-4 mt-4">
    <div class="section-title-row">
        <h2 class="h4">Mesajlar</h2>
        <span>@DisplayedFeedbackRows.Count kayıt</span>
    </div>

    @if (isAdmin)
    {
        <div class="feedback-user-layout">
            <aside class="feedback-user-panel">
                <label class="form-label" for="FeedbackUserSearch">Kullanıcı ara</label>
                <input id="FeedbackUserSearch" class="form-control" @bind="feedbackUserSearch" @bind:event="oninput" placeholder="Ad, e-posta veya rol" />

                <div class="feedback-user-list">
                    <button class="feedback-user-item @(selectedFeedbackUserId is null ? "selected" : null)" type="button" @onclick="() => SelectFeedbackUser(null)">
                        <strong>Tüm kullanıcılar</strong>
                        <span>@feedbackRows.Count mesaj</span>
                    </button>
                    @foreach (var user in FilteredFeedbackUsers())
                    {
                        <button class="feedback-user-item @(selectedFeedbackUserId == user.Id ? "selected" : null)" type="button" @onclick="() => SelectFeedbackUser(user.Id)">
                            <strong>@user.Name</strong>
                            <span>@user.RoleLabel - @user.MessageCount mesaj</span>
                        </button>
                    }
                </div>
            </aside>

            <div>
                @FeedbackAccordion()
            </div>
        </div>
    }
    else
    {
        @FeedbackAccordion()
    }
</section>

@code {
    private Guid athleteProfileId;
    private IReadOnlyList<CoachContactOption> coaches = [];
    private IReadOnlyList<RelatedFeedbackTarget> relatedTargets = [];
    private IReadOnlyList<FeedbackRow> feedbackRows = [];
    private IReadOnlyList<FeedbackUserRow> feedbackUsers = [];
    private IReadOnlyList<FeedbackGroup> feedbackGroups = [];
    private Guid? selectedFeedbackUserId;
    private bool isAdmin;
    private bool isCoach;
    private bool isParent;
    private string? feedbackUserSearch;
    private string? message;

    private IReadOnlyList<FeedbackRow> DisplayedFeedbackRows =>
        selectedFeedbackUserId is null
            ? feedbackRows
            : feedbackRows.Where(x =>
                x.AuthorUserId == selectedFeedbackUserId ||
                x.RecipientUserId == selectedFeedbackUserId ||
                x.AthleteUserId == selectedFeedbackUserId).ToList();

    protected override async Task OnInitializedAsync()
    {
        SetStatusMessage();
        await LoadAsync();
        if (isParent)
        {
            await MarkAllVisibleUnreadReadAsync();
        }
    }

    private RenderFragment FeedbackAccordion() => builder =>
    {
        BuildFeedbackGroups();
        if (DisplayedFeedbackRows.Count == 0)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "dashboard-empty");
            builder.OpenElement(2, "strong");
            builder.AddContent(3, "Henüz geri bildirim yok.");
            builder.CloseElement();
            builder.OpenElement(4, "p");
            builder.AddContent(5, "Mesaj gönderildiğinde veya size mesaj geldiğinde burada görüntülenir.");
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        builder.OpenElement(6, "div");
        builder.AddAttribute(7, "class", "feedback-accordion-list");
        var sequence = 8;
        foreach (var group in feedbackGroups)
        {
            builder.OpenElement(sequence++, "details");
            builder.AddAttribute(sequence++, "class", "feedback-athlete-group");

            builder.OpenElement(sequence++, "summary");
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => MarkFeedbackGroupReadAsync(group.AthleteProfileId)));
            builder.OpenElement(sequence++, "span");
            builder.OpenElement(sequence++, "strong");
            builder.AddContent(sequence++, group.AthleteName);
            builder.CloseElement();
            builder.OpenElement(sequence++, "small");
            builder.AddContent(sequence++, $"{group.Feedbacks.Count} mesaj");
            builder.CloseElement();
            builder.CloseElement();
            if (group.UnreadCount > 0)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "unread-feedback-badge");
                builder.AddContent(sequence++, $"{group.UnreadCount} yeni");
                builder.CloseElement();
            }
            builder.CloseElement();

            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "compact-list feedback-message-list");
            foreach (var row in group.Feedbacks)
            {
                builder.OpenElement(sequence++, "div");
                if (row.IsUnread)
                {
                    builder.AddAttribute(sequence++, "class", "feedback-message-unread");
                }
                builder.OpenElement(sequence++, "strong");
                builder.AddContent(sequence++, row.Date.ToLocalTime().ToString("dd.MM.yyyy HH:mm"));
                builder.CloseElement();
                builder.OpenElement(sequence++, "span");
                builder.AddContent(sequence++, $"{row.AuthorName} -> {row.RecipientName}");
                builder.CloseElement();
                builder.OpenElement(sequence++, "span");
                builder.AddContent(sequence++, row.Comment);
                builder.CloseElement();
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private void SetStatusMessage()
    {
        var parameters = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (parameters.ContainsKey("sent"))
        {
            message = "Başarılı: Geri bildiriminiz gönderildi.";
        }
        else if (parameters.TryGetValue("error", out var error))
        {
            message = $"Hata: {error}";
        }
    }

    private async Task LoadAsync()
    {
        if (CurrentUser.UserId is null)
        {
            return;
        }

        var currentUserId = CurrentUser.UserId.Value;
        isAdmin = CurrentUser.Roles.Contains(RoleNames.Admin);
        isCoach = CurrentUser.Roles.Contains(RoleNames.Coach);
        isParent = CurrentUser.Roles.Contains(RoleNames.Parent);

        if (CurrentUser.Roles.Contains(RoleNames.Athlete))
        {
            athleteProfileId = await Db.AthleteProfiles.AsNoTracking()
                .Where(x => x.UserId == currentUserId)
                .Select(x => x.Id)
                .FirstOrDefaultAsync(CancellationToken.None);

            coaches = await (
                from relation in Db.AthleteRelations.AsNoTracking()
                join user in Db.Users.AsNoTracking() on relation.RelatedUserId equals user.Id
                join photo in Db.FileAssets.AsNoTracking() on user.ProfilePhotoId equals photo.Id into photoJoin
                from photo in photoJoin.DefaultIfEmpty()
                where relation.AthleteProfileId == athleteProfileId &&
                      relation.RelationType == AthleteRelationType.Coach &&
                      relation.IsActive
                orderby user.FirstName, user.LastName
                select new CoachContactOption(
                    user.Id,
                    (user.FirstName + " " + user.LastName).Trim(),
                    user.PhoneNumber,
                    photo == null ? null : photo.RelativePath))
                .ToListAsync(CancellationToken.None);
        }

        if (isCoach || isParent)
        {
            relatedTargets = await LoadRelatedTargetsAsync(currentUserId, isCoach);
        }

        feedbackRows = await (
            from feedback in Db.Feedbacks.AsNoTracking()
            join profile in Db.AthleteProfiles.AsNoTracking() on feedback.AthleteProfileId equals profile.Id
            join athleteUser in Db.Users.AsNoTracking() on profile.UserId equals athleteUser.Id
            join authorUser in Db.Users.AsNoTracking() on feedback.AuthorUserId equals authorUser.Id
            join recipientUser in Db.Users.AsNoTracking() on feedback.RecipientUserId equals recipientUser.Id into recipientJoin
            from recipient in recipientJoin.DefaultIfEmpty()
            where isAdmin ||
                  feedback.AuthorUserId == currentUserId ||
                  feedback.RecipientUserId == currentUserId
            orderby feedback.FeedbackDate descending
            select new FeedbackRow(
                feedback.Id,
                feedback.AthleteProfileId,
                profile.UserId,
                (athleteUser.FirstName + " " + athleteUser.LastName).Trim(),
                feedback.AuthorUserId,
                (authorUser.FirstName + " " + authorUser.LastName).Trim(),
                feedback.RecipientUserId,
                recipient == null ? "Genel" : (recipient.FirstName + " " + recipient.LastName).Trim(),
                feedback.FeedbackDate,
                feedback.Comment,
                feedback.RecipientUserId == currentUserId && feedback.RecipientViewedAt == null))
            .ToListAsync(CancellationToken.None);

        BuildFeedbackUsers();
        BuildFeedbackGroups();
    }

    private void BuildFeedbackUsers()
    {
        if (!isAdmin)
        {
            feedbackUsers = [];
            return;
        }

        feedbackUsers = feedbackRows
            .SelectMany(row => new[]
            {
                new FeedbackUserSeed(row.AthleteUserId, row.AthleteName, "Sporcu"),
                new FeedbackUserSeed(row.AuthorUserId, row.AuthorName, "Gönderen"),
                row.RecipientUserId.HasValue ? new FeedbackUserSeed(row.RecipientUserId.Value, row.RecipientName, "Alıcı") : null
            })
            .Where(x => x is not null)
            .Select(x => x!)
            .GroupBy(x => x.Id)
            .Select(group => new FeedbackUserRow(
                group.Key,
                string.IsNullOrWhiteSpace(group.First().Name) ? "İsimsiz kullanıcı" : group.First().Name,
                group.First().RoleLabel,
                feedbackRows.Count(row =>
                    row.AthleteUserId == group.Key ||
                    row.AuthorUserId == group.Key ||
                    row.RecipientUserId == group.Key)))
            .OrderBy(x => x.Name)
            .ToList();
    }

    private void BuildFeedbackGroups()
    {
        feedbackGroups = DisplayedFeedbackRows
            .GroupBy(x => new { x.AthleteProfileId, x.AthleteName })
            .Select(x => new FeedbackGroup(
                x.Key.AthleteProfileId,
                string.IsNullOrWhiteSpace(x.Key.AthleteName) ? "İsimsiz sporcu" : x.Key.AthleteName,
                x.OrderByDescending(row => row.Date).ToList(),
                x.Count(row => row.IsUnread)))
            .OrderByDescending(x => x.UnreadCount)
            .ThenBy(x => x.AthleteName)
            .ToList();
    }

    private void SelectFeedbackUser(Guid? userId)
    {
        selectedFeedbackUserId = userId;
        BuildFeedbackGroups();
    }

    private IEnumerable<FeedbackUserRow> FilteredFeedbackUsers() =>
        string.IsNullOrWhiteSpace(feedbackUserSearch)
            ? feedbackUsers
            : feedbackUsers.Where(x =>
                Contains(x.Name, feedbackUserSearch) ||
                Contains(x.RoleLabel, feedbackUserSearch));

    private async Task MarkAllVisibleUnreadReadAsync()
    {
        if (CurrentUser.UserId is null)
        {
            return;
        }

        var currentUserId = CurrentUser.UserId.Value;
        var unreadFeedbacks = await Db.Feedbacks
            .Where(x => x.RecipientUserId == currentUserId && x.RecipientViewedAt == null)
            .ToListAsync(CancellationToken.None);

        if (unreadFeedbacks.Count == 0)
        {
            return;
        }

        var now = DateTimeOffset.UtcNow;
        foreach (var feedback in unreadFeedbacks)
        {
            feedback.RecipientViewedAt = now;
            feedback.UpdatedAt = now;
        }

        await Db.SaveChangesAsync(CancellationToken.None);
        feedbackRows = feedbackRows.Select(row => row.IsUnread ? row with { IsUnread = false } : row).ToList();
        BuildFeedbackGroups();
    }

    private async Task MarkFeedbackGroupReadAsync(Guid athleteProfileId)
    {
        if (CurrentUser.UserId is null)
        {
            return;
        }

        var currentUserId = CurrentUser.UserId.Value;
        var unreadFeedbacks = await Db.Feedbacks
            .Where(x =>
                x.AthleteProfileId == athleteProfileId &&
                x.RecipientUserId == currentUserId &&
                x.RecipientViewedAt == null)
            .ToListAsync(CancellationToken.None);

        if (unreadFeedbacks.Count == 0)
        {
            return;
        }

        var now = DateTimeOffset.UtcNow;
        foreach (var feedback in unreadFeedbacks)
        {
            feedback.RecipientViewedAt = now;
            feedback.UpdatedAt = now;
        }

        await Db.SaveChangesAsync(CancellationToken.None);
        feedbackRows = feedbackRows
            .Select(row => row.AthleteProfileId == athleteProfileId && row.IsUnread ? row with { IsUnread = false } : row)
            .ToList();
        BuildFeedbackGroups();
    }

    private async Task<IReadOnlyList<RelatedFeedbackTarget>> LoadRelatedTargetsAsync(Guid currentUserId, bool currentUserIsCoach)
    {
        var currentRelationType = currentUserIsCoach ? AthleteRelationType.Coach : AthleteRelationType.Parent;
        var targetRelationType = currentUserIsCoach ? AthleteRelationType.Parent : AthleteRelationType.Coach;

        return await (
            from currentRelation in Db.AthleteRelations.AsNoTracking()
            join targetRelation in Db.AthleteRelations.AsNoTracking() on currentRelation.AthleteProfileId equals targetRelation.AthleteProfileId
            join profile in Db.AthleteProfiles.AsNoTracking() on currentRelation.AthleteProfileId equals profile.Id
            join athleteUser in Db.Users.AsNoTracking() on profile.UserId equals athleteUser.Id
            join recipient in Db.Users.AsNoTracking() on targetRelation.RelatedUserId equals recipient.Id
            where currentRelation.RelatedUserId == currentUserId &&
                  currentRelation.RelationType == currentRelationType &&
                  currentRelation.IsActive &&
                  targetRelation.RelationType == targetRelationType &&
                  targetRelation.IsActive &&
                  recipient.IsActive
            orderby athleteUser.FirstName, athleteUser.LastName, recipient.FirstName, recipient.LastName
            select new RelatedFeedbackTarget(
                profile.Id,
                (athleteUser.FirstName + " " + athleteUser.LastName).Trim(),
                recipient.Id,
                (recipient.FirstName + " " + recipient.LastName).Trim()))
            .ToListAsync(CancellationToken.None);
    }

    private static bool Contains(string? value, string query) =>
        value?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;

    private static string DisplayPhone(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Telefon girilmemiş" : value;

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(x => x[0])).ToUpperInvariant();
    }

    private static string PhotoUrl(string path) =>
        path.StartsWith("/", StringComparison.Ordinal) ? path : $"/{path.Replace('\\', '/')}";

    private sealed record CoachContactOption(Guid Id, string Name, string? PhoneNumber, string? PhotoPath);
    private sealed record RelatedFeedbackTarget(Guid AthleteProfileId, string AthleteName, Guid RecipientUserId, string RecipientName);
    private sealed record FeedbackRow(Guid Id, Guid AthleteProfileId, Guid AthleteUserId, string AthleteName, Guid AuthorUserId, string AuthorName, Guid? RecipientUserId, string RecipientName, DateTimeOffset Date, string Comment, bool IsUnread);
    private sealed record FeedbackGroup(Guid AthleteProfileId, string AthleteName, IReadOnlyList<FeedbackRow> Feedbacks, int UnreadCount);
    private sealed record FeedbackUserSeed(Guid Id, string Name, string RoleLabel);
    private sealed record FeedbackUserRow(Guid Id, string Name, string RoleLabel, int MessageCount);
}
