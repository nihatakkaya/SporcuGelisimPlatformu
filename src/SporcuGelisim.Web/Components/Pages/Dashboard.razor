@page "/dashboard"
@attribute [Authorize]
@inject IDashboardService DashboardService

<PageTitle>Panel</PageTitle>

@if (summary is null)
{
    <section class="dashboard-loading" aria-live="polite">
        <div class="spinner-border text-primary" role="status"></div>
        <span>Panel yükleniyor...</span>
    </section>
}
else
{
    <section class="page-hero dashboard-admin-hero">
        <div>
            <p class="dashboard-kicker">Sporcu Gelişim Platformu</p>
            <AuthorizeView Roles="@RoleNames.Admin">
                <h1>Yönetim Merkezi</h1>
                <p>Hesap oluşturma, branş düzenleme, raporlar ve genel sistem takibi için ana ekran.</p>
            </AuthorizeView>
            <AuthorizeView Roles="@RoleNames.Coach">
                <h1>Antrenör Paneli</h1>
                <p>Size bağlı sporcuları inceleyin, kelime havuzunuzu yönetin ve gelişim notlarını takip edin.</p>
            </AuthorizeView>
            <AuthorizeView Roles="@RoleNames.Athlete">
                <h1>Sporcu Paneli</h1>
                <p>Profil bilgilerinizi tamamlayın, oturumlarınızı ve geri bildirimlerinizi takip edin.</p>
            </AuthorizeView>
            <AuthorizeView Roles="@RoleNames.Parent">
                <h1>Ebeveyn Paneli</h1>
                <p>İlişkili sporcuların gelişim notlarını ve geri bildirimlerini takip edin.</p>
            </AuthorizeView>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="hero-account-card">
                    <span>Aktif bölüm</span>
                    <strong>Hesap</strong>
                    <a href="Account/Manage">Hesap bilgileri</a>
                </div>
            </Authorized>
        </AuthorizeView>
    </section>

    <AuthorizeView Roles="@RoleNames.Coach">
        <section class="dashboard-stats" aria-label="Genel özet">
            <article class="dashboard-stat">
                <span>Sporcu</span>
                <strong>@summary.AthleteCount</strong>
            </article>
            <article class="dashboard-stat">
                <span>Antrenör</span>
                <strong>@summary.CoachCount</strong>
            </article>
            <article class="dashboard-stat">
                <span>Ebeveyn</span>
                <strong>@summary.ParentCount</strong>
            </article>
            <article class="dashboard-stat">
                <span>Oturum</span>
                <strong>@summary.SessionCount</strong>
            </article>
        </section>
    </AuthorizeView>

    <div class="dashboard-grid">
        <section class="dashboard-panel">
            <div class="dashboard-panel-header">
                <div>
                    <p class="dashboard-kicker">Hızlı İşlemler</p>
                    <h2>Bugün ne yapılacak?</h2>
                </div>
            </div>

            <div class="dashboard-actions">
                <AuthorizeView Roles="@RoleNames.Admin">
                    <a class="dashboard-action primary-action" href="Account/Register">
                        <strong>Kayıt oluştur</strong>
                        <span>Sporcu, antrenör, ebeveyn veya admin hesabı açın.</span>
                    </a>
                    <a class="dashboard-action" href="admin/branches">
                        <strong>Branşları yönet</strong>
                        <span>Spor dallarını ve alt branşları düzenleyin.</span>
                    </a>
                    <a class="dashboard-action" href="admin/reports">
                        <strong>Raporları incele</strong>
                        <span>Branş dağılımı ve kelime kullanım özetlerini görün.</span>
                    </a>
                    <a class="dashboard-action" href="admin/relations">
                        <strong>Sporcu ataması yap</strong>
                        <span>Sporcuları sorumlu antrenör veya ebeveyn hesaplarına bağlayın.</span>
                    </a>
                </AuthorizeView>

                <AuthorizeView Roles="@RoleNames.Coach">
                    <a class="dashboard-action primary-action" href="coach/athletes">
                        <strong>Sporcularımı aç</strong>
                        <span>Size bağlı sporcuların bilgilerini ve oturumlarını inceleyin.</span>
                    </a>
                    <a class="dashboard-action" href="coach/words">
                        <strong>Kelime havuzunu yönet</strong>
                        <span>Kelimeleri ekleyin, düzenleyin ve sporculara atayın.</span>
                    </a>
                </AuthorizeView>

                <AuthorizeView Roles="@RoleNames.Athlete">
                    <a class="dashboard-action primary-action" href="athlete/profile">
                        <strong>Profilimi tamamla</strong>
                        <span>TC kimlik, telefon, adres, branş ve görsel bilgilerinizi güncelleyin.</span>
                    </a>
                    <a class="dashboard-action" href="athlete/sessions">
                        <strong>Oturumlarımı aç</strong>
                        <span>Antrenman ve gelişim oturumlarınızı görüntüleyin.</span>
                    </a>
                    <a class="dashboard-action" href="athlete/words">
                        <strong>Kelime havuzum</strong>
                        <span>Size atanmış kelimeleri görün ve antrenörünüze yeni kelime isteği gönderin.</span>
                    </a>
                </AuthorizeView>

                <a class="dashboard-action" href="feedback">
                    <strong>Geri bildirimler</strong>
                    <span>Sporcu gelişim notlarını ve yorumları takip edin.</span>
                </a>
            </div>
        </section>

        <section class="dashboard-panel">
            <div class="dashboard-panel-header">
                <div>
                    <p class="dashboard-kicker">Sistem Durumu</p>
                    <h2>Kurulum özeti</h2>
                </div>
            </div>

            @if (summary.AthleteCount == 0 && summary.SessionCount == 0)
            {
                <div class="dashboard-empty">
                    <strong>Henüz sporcu ve oturum kaydı yok.</strong>
                    <p>Önce kayıt oluşturma ekranından kullanıcı açın, ardından sporcu profilini ve ilişkileri tamamlayın.</p>
                </div>
            }
            else
            {
                <ul class="dashboard-checklist">
                    <li>Sporcu kayıtları takip ediliyor.</li>
                    <li>Rol bazlı ekranlar aktif.</li>
                    <li>Rapor ve geri bildirim akışı hazır.</li>
                </ul>
            }
        </section>
    </div>
}

@code {
    private DashboardSummaryDto? summary;

    protected override async Task OnInitializedAsync()
    {
        summary = await DashboardService.GetSummaryAsync(CancellationToken.None);
    }
}
