@page "/admin/branches"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RoleNames.Admin)]
@inject IBranchService BranchService

<PageTitle>Branşlar</PageTitle>

<section class="page-hero compact-hero">
    <div>
        <p class="dashboard-kicker">Admin</p>
        <h1>Branş Yönetimi</h1>
        <p>Spor branşlarını ekleyin, düzenleyin veya kullanımdan kaldırın.</p>
    </div>
    <div class="hero-badge">
        <span>Aktif branş</span>
        <strong>@branches.Count(x => x.IsActive)</strong>
    </div>
</section>

<section class="content-card p-4">
    <div class="page-heading compact">
        <h2>@(editingBranchId.HasValue ? "Branşı düzenle" : "Yeni branş ekle")</h2>
    </div>

    <EditForm Model="input" OnValidSubmit="SaveBranchAsync" FormName="branch-save">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" role="alert" />
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="BranchName">Branş adı</label>
                <InputText id="BranchName" class="form-control" @bind-Value="input.Name" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="BranchDescription">Açıklama</label>
                <InputText id="BranchDescription" class="form-control" @bind-Value="input.Description" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="ParentBranch">Üst branş</label>
                <InputSelect id="ParentBranch" class="form-select" @bind-Value="input.ParentBranchId">
                    <option value="">Yok</option>
                    @foreach (var branch in branches.Where(x => x.IsActive && x.Id != editingBranchId))
                    {
                        <option value="@branch.Id">@branch.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-1">
                <button class="btn btn-primary w-100" type="submit">@(editingBranchId.HasValue ? "Kaydet" : "Ekle")</button>
            </div>
        </div>
        @if (editingBranchId.HasValue)
        {
            <button class="btn btn-outline-secondary mt-3" type="button" @onclick="CancelEdit">Vazgeç</button>
        }
    </EditForm>

    <StatusMessage Message="@message" />
</section>

<section class="content-card p-4 mt-4">
    <div class="section-title-row">
        <h2 class="h4">Kayıtlı branşlar</h2>
        <span>@branches.Count kayıt</span>
    </div>

    @if (branches.Count == 0)
    {
        <div class="dashboard-empty">
            <strong>Henüz branş yok.</strong>
            <p>İlk branşı yukarıdaki formdan ekleyebilirsiniz.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle">
                <thead>
                    <tr>
                        <th>Ad</th>
                        <th>Kısa ad</th>
                        <th>Üst branş</th>
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var branch in branches)
                    {
                        <tr>
                            <td><strong>@branch.Name</strong></td>
                            <td>@branch.Slug</td>
                            <td>@(branches.FirstOrDefault(x => x.Id == branch.ParentBranchId)?.Name ?? "Yok")</td>
                            <td><span class="status-pill @(branch.IsActive ? "active" : "passive")">@(branch.IsActive ? "Aktif" : "Pasif")</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary me-2" type="button" @onclick="() => EditBranch(branch)">Düzenle</button>
                                @if (branch.IsActive)
                                {
                                    <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => DeactivateBranchAsync(branch)">Sil</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private BranchInput input = new();
    private IReadOnlyList<BranchDto> branches = [];
    private Guid? editingBranchId;
    private string? message;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SaveBranchAsync()
    {
        try
        {
            if (editingBranchId.HasValue)
            {
                await BranchService.UpdateAsync(new UpdateBranchRequest(editingBranchId.Value, input.Name, input.Description, input.ParentBranchId, 0, true), CancellationToken.None);
                message = "Başarılı: Branş güncellendi.";
            }
            else
            {
                await BranchService.CreateAsync(new CreateBranchRequest(input.Name, input.Description, input.ParentBranchId, 0), CancellationToken.None);
                message = "Başarılı: Branş eklendi.";
            }

            input = new();
            editingBranchId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = $"Hata: {ex.Message}";
        }
    }

    private void EditBranch(BranchDto branch)
    {
        editingBranchId = branch.Id;
        input = new BranchInput
        {
            Name = branch.Name,
            Description = branch.Description,
            ParentBranchId = branch.ParentBranchId
        };
    }

    private async Task DeactivateBranchAsync(BranchDto branch)
    {
        try
        {
            await BranchService.UpdateAsync(new UpdateBranchRequest(branch.Id, branch.Name, branch.Description, branch.ParentBranchId, branch.DisplayOrder, false), CancellationToken.None);
            message = "Başarılı: Branş silindi.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = $"Hata: {ex.Message}";
        }
    }

    private void CancelEdit()
    {
        editingBranchId = null;
        input = new();
    }

    private async Task LoadAsync() => branches = await BranchService.GetTreeAsync(CancellationToken.None);

    private sealed class BranchInput
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public Guid? ParentBranchId { get; set; }
    }
}
