@page "/admin/relations"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RoleNames.Admin)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using SporcuGelisim.Domain.Entities
@using SporcuGelisim.Domain.Enums
@using SporcuGelisim.Infrastructure.Data
@using SporcuGelisim.Infrastructure.Identity
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Sporcu Atama</PageTitle>

<section class="page-hero compact-hero">
    <div>
        <p class="dashboard-kicker">Admin</p>
        <h1>Sporcu Atama</h1>
        <p>Sporcuları sorumlu antrenör veya ebeveyn hesaplarına bağlayın. Antrenörler yalnızca burada kendilerine atanmış sporcuları görür.</p>
    </div>
    <div class="hero-badge">
        <span>Aktif ilişki</span>
        <strong>@relations.Count</strong>
    </div>
</section>

<section class="content-card p-4">
    <div class="page-heading compact">
        <h2>Yeni ilişki oluştur</h2>
    </div>

    <EditForm Model="input" OnValidSubmit="AssignAsync" FormName="relation-assign">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" role="alert" />

        <div class="relation-type-switch" role="tablist" aria-label="İlişki türü">
            <button class="@(input.RelationType == AthleteRelationType.Coach ? "active" : null)" type="button" @onclick="() => SetRelationType(AthleteRelationType.Coach)">
                Antrenör
            </button>
            <button class="@(input.RelationType == AthleteRelationType.Parent ? "active" : null)" type="button" @onclick="() => SetRelationType(AthleteRelationType.Parent)">
                Ebeveyn
            </button>
        </div>

        <div class="relation-picker-grid mt-3">
            <details class="picker-panel" open>
                <summary>Sporcu seç</summary>
                <input class="form-control mt-3" @bind="athleteSearch" @bind:event="oninput" placeholder="Sporcu adı veya branş yazın" />
                <div class="picker-list">
                    @foreach (var athlete in FilterAthletes())
                    {
                        <button class="picker-row @(input.AthleteProfileId == athlete.Id ? "selected" : null)" type="button" @onclick="() => SelectAthlete(athlete)">
                            <strong>@athlete.Name</strong>
                            <span>@athlete.BranchName</span>
                        </button>
                    }
                </div>
            </details>

            <details class="picker-panel" open>
                <summary>@(input.RelationType == AthleteRelationType.Coach ? "Antrenör seç" : "Ebeveyn seç")</summary>
                <input class="form-control mt-3" @bind="userSearch" @bind:event="oninput" placeholder="Ad soyad yazın" />
                <div class="picker-list">
                    @foreach (var user in FilterUsers())
                    {
                        <button class="picker-row @(input.RelatedUserId == user.Id ? "selected" : null)" type="button" @onclick="() => SelectUser(user)">
                            <strong>@user.Name</strong>
                            <span>@(input.RelationType == AthleteRelationType.Coach ? "Antrenör" : "Ebeveyn")</span>
                        </button>
                    }
                </div>
            </details>
        </div>

        <div class="selected-summary mt-3">
            <span>Sporcu: <strong>@(selectedAthlete?.Name ?? "Seçilmedi")</strong></span>
            <span>Hesap: <strong>@(selectedUser?.Name ?? "Seçilmedi")</strong></span>
        </div>

        <button class="btn btn-primary mt-3" type="submit" disabled="@(!input.AthleteProfileId.HasValue || !input.RelatedUserId.HasValue)">Ata</button>
    </EditForm>

    <StatusMessage Message="@message" />
</section>

<section class="content-card p-4 mt-4">
    <div class="section-title-row">
        <h2 class="h4">Aktif atamalar</h2>
        <span>@relations.Count kayıt</span>
    </div>

    @if (relations.Count == 0)
    {
        <div class="dashboard-empty">
            <strong>Henüz atama yok.</strong>
            <p>Antrenörlerin sporcuları görebilmesi için önce buradan ilişki oluşturun.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle">
                <thead>
                    <tr>
                        <th>Sporcu</th>
                        <th>Branş</th>
                        <th>Atanan hesap</th>
                        <th>Tür</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var relation in relations)
                    {
                        <tr>
                            <td><strong>@relation.AthleteName</strong></td>
                            <td>@relation.BranchName</td>
                            <td>@relation.RelatedUserName</td>
                            <td>@(relation.RelationType == AthleteRelationType.Coach ? "Antrenör" : "Ebeveyn")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private RelationInput input = new();
    private IReadOnlyList<AthleteOption> athletes = [];
    private IReadOnlyList<UserOption> coaches = [];
    private IReadOnlyList<UserOption> parents = [];
    private IReadOnlyList<RelationRow> relations = [];
    private AthleteOption? selectedAthlete;
    private UserOption? selectedUser;
    private string? athleteSearch;
    private string? userSearch;
    private string? message;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private IEnumerable<AthleteOption> FilterAthletes() =>
        string.IsNullOrWhiteSpace(athleteSearch)
            ? athletes
            : athletes.Where(x => Contains(x.Name, athleteSearch) || Contains(x.BranchName, athleteSearch));

    private IEnumerable<UserOption> FilterUsers()
    {
        var source = input.RelationType == AthleteRelationType.Parent ? parents : coaches;
        return string.IsNullOrWhiteSpace(userSearch)
            ? source
            : source.Where(x => Contains(x.Name, userSearch));
    }

    private void SetRelationType(AthleteRelationType relationType)
    {
        input.RelationType = relationType;
        input.RelatedUserId = null;
        selectedUser = null;
        userSearch = null;
    }

    private void SelectAthlete(AthleteOption athlete)
    {
        selectedAthlete = athlete;
        input.AthleteProfileId = athlete.Id;
    }

    private void SelectUser(UserOption user)
    {
        selectedUser = user;
        input.RelatedUserId = user.Id;
    }

    private async Task AssignAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (!authState.User.IsInRole(RoleNames.Admin))
            {
                message = "Hata: Sporcu ataması yalnızca Admin hesabıyla yapılabilir.";
                return;
            }

            var adminUser = await UserManager.GetUserAsync(authState.User);
            var exists = await Db.AthleteRelations.AnyAsync(x =>
                x.AthleteProfileId == input.AthleteProfileId!.Value &&
                x.RelatedUserId == input.RelatedUserId!.Value &&
                x.RelationType == input.RelationType &&
                x.IsActive,
                CancellationToken.None);
            if (exists)
            {
                message = "Hata: Bu sporcu ile seçilen hesap arasında aktif ilişki zaten var.";
                return;
            }

            Db.AthleteRelations.Add(new AthleteRelation
            {
                AthleteProfileId = input.AthleteProfileId!.Value,
                RelatedUserId = input.RelatedUserId!.Value,
                RelationType = input.RelationType,
                CreatedByUserId = adminUser?.Id
            });
            await Db.SaveChangesAsync(CancellationToken.None);
            input = new();
            selectedAthlete = null;
            selectedUser = null;
            athleteSearch = null;
            userSearch = null;
            message = "Başarılı: Sporcu ataması yapıldı.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = $"Hata: {ex.Message}";
        }
    }

    private async Task LoadAsync()
    {
        athletes = await (
            from profile in Db.AthleteProfiles.AsNoTracking()
            join user in Db.Users.AsNoTracking() on profile.UserId equals user.Id
            join branch in Db.SportBranches.AsNoTracking() on profile.PrimaryBranchId equals branch.Id into branchJoin
            from branch in branchJoin.DefaultIfEmpty()
            orderby user.FirstName, user.LastName
            select new AthleteOption(profile.Id, (user.FirstName + " " + user.LastName).Trim(), branch == null ? "Branş girilmemiş" : branch.Name))
            .ToListAsync(CancellationToken.None);

        coaches = await GetUsersInRoleAsync(RoleNames.Coach);
        parents = await GetUsersInRoleAsync(RoleNames.Parent);

        relations = await (
            from relation in Db.AthleteRelations.AsNoTracking()
            join profile in Db.AthleteProfiles.AsNoTracking() on relation.AthleteProfileId equals profile.Id
            join athleteUser in Db.Users.AsNoTracking() on profile.UserId equals athleteUser.Id
            join relatedUser in Db.Users.AsNoTracking() on relation.RelatedUserId equals relatedUser.Id
            join branch in Db.SportBranches.AsNoTracking() on profile.PrimaryBranchId equals branch.Id into branchJoin
            from branch in branchJoin.DefaultIfEmpty()
            where relation.IsActive
            orderby athleteUser.FirstName, athleteUser.LastName
            select new RelationRow(
                (athleteUser.FirstName + " " + athleteUser.LastName).Trim(),
                branch == null ? "Branş girilmemiş" : branch.Name,
                (relatedUser.FirstName + " " + relatedUser.LastName).Trim(),
                relation.RelationType))
            .ToListAsync(CancellationToken.None);
    }

    private async Task<IReadOnlyList<UserOption>> GetUsersInRoleAsync(string roleName) =>
        await (
            from user in Db.Users.AsNoTracking()
            join userRole in Db.UserRoles.AsNoTracking() on user.Id equals userRole.UserId
            join role in Db.Roles.AsNoTracking() on userRole.RoleId equals role.Id
            where role.Name == roleName && user.IsActive
            orderby user.FirstName, user.LastName
            select new UserOption(user.Id, (user.FirstName + " " + user.LastName).Trim()))
            .ToListAsync(CancellationToken.None);

    private static bool Contains(string? value, string query) =>
        value?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;

    private sealed class RelationInput
    {
        [Required(ErrorMessage = "Sporcu seçimi zorunludur.")]
        public Guid? AthleteProfileId { get; set; }

        [Required(ErrorMessage = "Hesap seçimi zorunludur.")]
        public Guid? RelatedUserId { get; set; }

        public AthleteRelationType RelationType { get; set; } = AthleteRelationType.Coach;
    }

    private sealed record AthleteOption(Guid Id, string Name, string BranchName);
    private sealed record UserOption(Guid Id, string Name);
    private sealed record RelationRow(string AthleteName, string BranchName, string RelatedUserName, AthleteRelationType RelationType);
}
