@page "/admin/relations"
@attribute [Authorize(Roles = RoleNames.Admin)]
@using Microsoft.EntityFrameworkCore
@using SporcuGelisim.Domain.Enums
@using SporcuGelisim.Infrastructure.Data
@inject ApplicationDbContext Db
@inject NavigationManager Navigation

<PageTitle>Sporcu Atama</PageTitle>

<section class="page-hero compact-hero">
    <div>
        <p class="dashboard-kicker">Admin</p>
        <h1>Sporcu Atama</h1>
        <p>Soldan sporcuyu, sağdan antrenör veya ebeveyn hesabını seçerek aktif ilişki oluşturun.</p>
    </div>
    <div class="hero-badge">
        <span>Aktif ilişki</span>
        <strong>@relations.Count</strong>
    </div>
</section>

<section class="content-card p-4">
    <div class="page-heading compact">
        <h2>Yeni ilişki oluştur</h2>
    </div>

    <StatusMessage Message="@message" />

    <form method="post" action="/admin/relations/assign" data-enhance="false">
        <AntiforgeryToken />

        <div class="relation-type-switch relation-type-static" role="radiogroup" aria-label="İlişki türü">
            <label>
                <input type="radio" name="RelationType" value="@AthleteRelationType.Coach" checked />
                <span>Antrenör</span>
            </label>
            <label>
                <input type="radio" name="RelationType" value="@AthleteRelationType.Parent" />
                <span>Ebeveyn</span>
            </label>
        </div>

        <div class="relation-picker-grid mt-3 static-relation-picker">
            <section class="picker-panel">
                <h3>Sporcu seç</h3>
                <div class="search-inline">
                    <input type="search" class="form-control" placeholder="Sporcu ara" data-picker-search data-search-target="#athlete-picker-list" />
                    <button type="button" class="btn btn-outline-secondary" data-picker-search-button>Ara</button>
                </div>
                <div id="athlete-picker-list" class="picker-list">
                    @foreach (var athlete in athletes)
                    {
                        <label class="picker-row radio-picker-row" data-search-text="@($"{athlete.Name} {athlete.BranchName}")">
                            <input type="radio" name="AthleteProfileId" value="@athlete.Id" required />
                            <span>
                                <strong>@athlete.Name</strong>
                                <small>@athlete.BranchName</small>
                            </span>
                        </label>
                    }
                </div>
            </section>

            <section class="picker-panel relation-target-panel coach-targets">
                <h3>Antrenör seç</h3>
                <div class="search-inline">
                    <input type="search" class="form-control" placeholder="Antrenör ara" data-picker-search data-search-target="#coach-picker-list" />
                    <button type="button" class="btn btn-outline-secondary" data-picker-search-button>Ara</button>
                </div>
                <div id="coach-picker-list" class="picker-list">
                    @foreach (var coach in coaches)
                    {
                        <label class="picker-row radio-picker-row" data-search-text="@coach.Name">
                            <input type="radio" name="RelatedCoachUserId" value="@coach.Id" />
                            <span>
                                <strong>@coach.Name</strong>
                                <small>Antrenör</small>
                            </span>
                        </label>
                    }
                </div>
            </section>

            <section class="picker-panel relation-target-panel parent-targets">
                <h3>Ebeveyn seç</h3>
                <div class="search-inline">
                    <input type="search" class="form-control" placeholder="Ebeveyn ara" data-picker-search data-search-target="#parent-picker-list" />
                    <button type="button" class="btn btn-outline-secondary" data-picker-search-button>Ara</button>
                </div>
                <div id="parent-picker-list" class="picker-list">
                    @foreach (var parent in parents)
                    {
                        <label class="picker-row radio-picker-row" data-search-text="@parent.Name">
                            <input type="radio" name="RelatedParentUserId" value="@parent.Id" />
                            <span>
                                <strong>@parent.Name</strong>
                                <small>Ebeveyn</small>
                            </span>
                        </label>
                    }
                </div>
            </section>
        </div>

        <button class="btn btn-primary mt-3" type="submit" disabled="@(athletes.Count == 0 || (coaches.Count == 0 && parents.Count == 0))">Ata</button>
    </form>
</section>

<section class="content-card p-4 mt-4">
    <div class="section-title-row">
        <h2 class="h4">Aktif atamalar</h2>
        <span>@relations.Count kayıt</span>
    </div>

    @if (relations.Count == 0)
    {
        <div class="dashboard-empty">
            <strong>Henüz atama yok.</strong>
            <p>Antrenörlerin ve ebeveynlerin sporcuları görebilmesi için önce buradan ilişki oluşturun.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle">
                <thead>
                    <tr>
                        <th>Sporcu</th>
                        <th>Branş</th>
                        <th>Atanan hesap</th>
                        <th>Tür</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var relation in relations)
                    {
                        <tr>
                            <td><strong>@relation.AthleteName</strong></td>
                            <td>@relation.BranchName</td>
                            <td>@relation.RelatedUserName</td>
                            <td>@(relation.RelationType == AthleteRelationType.Coach ? "Antrenör" : "Ebeveyn")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private IReadOnlyList<AthleteOption> athletes = [];
    private IReadOnlyList<UserOption> coaches = [];
    private IReadOnlyList<UserOption> parents = [];
    private IReadOnlyList<RelationRow> relations = [];
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        SetMessage();
        await LoadAsync();
    }

    private void SetMessage()
    {
        var query = new Uri(Navigation.Uri).Query;
        if (query.Contains("assigned=1", StringComparison.OrdinalIgnoreCase))
        {
            message = "Başarılı: Sporcu ataması yapıldı.";
        }
        else if (query.Contains("duplicate=1", StringComparison.OrdinalIgnoreCase))
        {
            message = "Hata: Bu sporcu ile seçilen hesap arasında aktif ilişki zaten var.";
        }
        else if (query.Contains("missing=1", StringComparison.OrdinalIgnoreCase))
        {
            message = "Hata: Sporcu ve hesap seçimi zorunludur.";
        }
        else if (query.Contains("invalid=1", StringComparison.OrdinalIgnoreCase))
        {
            message = "Hata: Seçilen hesap türü geçersiz.";
        }
    }

    private async Task LoadAsync()
    {
        athletes = await (
            from profile in Db.AthleteProfiles.AsNoTracking()
            join user in Db.Users.AsNoTracking() on profile.UserId equals user.Id
            join branch in Db.SportBranches.AsNoTracking() on profile.PrimaryBranchId equals branch.Id into branchJoin
            from branch in branchJoin.DefaultIfEmpty()
            where user.IsActive && !profile.IsDeleted
            orderby user.FirstName, user.LastName
            select new AthleteOption(profile.Id, (user.FirstName + " " + user.LastName).Trim(), branch == null ? "Branş girilmemiş" : branch.Name))
            .ToListAsync(CancellationToken.None);

        coaches = await GetUsersInRoleAsync(RoleNames.Coach);
        parents = await GetUsersInRoleAsync(RoleNames.Parent);

        relations = await (
            from relation in Db.AthleteRelations.AsNoTracking()
            join profile in Db.AthleteProfiles.AsNoTracking() on relation.AthleteProfileId equals profile.Id
            join athleteUser in Db.Users.AsNoTracking() on profile.UserId equals athleteUser.Id
            join relatedUser in Db.Users.AsNoTracking() on relation.RelatedUserId equals relatedUser.Id
            join branch in Db.SportBranches.AsNoTracking() on profile.PrimaryBranchId equals branch.Id into branchJoin
            from branch in branchJoin.DefaultIfEmpty()
            where relation.IsActive && !profile.IsDeleted && athleteUser.IsActive && relatedUser.IsActive
            orderby athleteUser.FirstName, athleteUser.LastName
            select new RelationRow(
                (athleteUser.FirstName + " " + athleteUser.LastName).Trim(),
                branch == null ? "Branş girilmemiş" : branch.Name,
                (relatedUser.FirstName + " " + relatedUser.LastName).Trim(),
                relation.RelationType))
            .ToListAsync(CancellationToken.None);
    }

    private async Task<IReadOnlyList<UserOption>> GetUsersInRoleAsync(string roleName) =>
        await (
            from user in Db.Users.AsNoTracking()
            join userRole in Db.UserRoles.AsNoTracking() on user.Id equals userRole.UserId
            join role in Db.Roles.AsNoTracking() on userRole.RoleId equals role.Id
            where role.Name == roleName && user.IsActive
            orderby user.FirstName, user.LastName
            select new UserOption(user.Id, (user.FirstName + " " + user.LastName).Trim()))
            .ToListAsync(CancellationToken.None);

    private sealed record AthleteOption(Guid Id, string Name, string BranchName);
    private sealed record UserOption(Guid Id, string Name);
    private sealed record RelationRow(string AthleteName, string BranchName, string RelatedUserName, AthleteRelationType RelationType);
}
