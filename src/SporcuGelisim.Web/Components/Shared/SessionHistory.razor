@if (Detail is not null)
{
    @if (!Detail.HasWordHistory) { <p class="alert alert-info">Bu oturum eski sistemde oluşturuldu. Başlangıç geçmişi eksik olabilir; yalnızca kaydedilmiş bilgiler gösterilir.</p> }
    <div class="session-history-grid">
        <section class="history-panel"><h3>Önceki Oturumdan Gelen Kelimeler</h3>
            <div class="session-chips">@foreach (var word in Detail.BeginningWords) { <span class="session-chip">@word.Text</span> }</div>
            @if (Detail.BeginningWords.Count == 0) { <p class="text-muted">Başlangıç kelimesi kaydedilmemiş.</p> }
        </section>
        <section class="history-panel"><h3>Oturum Sonundaki Kelimeler</h3>
            <div class="session-chips">@foreach (var word in Detail.EndingWords) { <span class="session-chip">@word.Text</span> }</div>
            @if (Detail.EndingWords.Count == 0) { <p class="text-muted">Kelime yok.</p> }
        </section>
        <section class="history-panel"><h3>Bu Oturumda Eklenenler</h3><div class="session-chips">
            @foreach (var change in Detail.Changes.Where(x => x.Added)) { <span class="session-chip added" title="@ChangeTitle(change)">+ @change.Text</span> }
        </div></section>
        <section class="history-panel"><h3>Bu Oturumda Çıkarılanlar</h3><div class="session-chips">
            @foreach (var change in Detail.Changes.Where(x => !x.Added)) { <span class="session-chip removed" title="@ChangeTitle(change)">− @change.Text</span> }
        </div></section>
    </div>
    @if (Detail.Changes.Count == 0) { <p class="text-muted mt-3">Bu oturumda henüz kelime değişikliği yok.</p> }
    else
    {
        <details class="mt-3"><summary>Değişiklik zaman çizelgesi (@Detail.Changes.Count)</summary>
            <ul class="session-timeline">@foreach (var change in Detail.Changes) { <li><strong>@(change.Added ? "+" : "−") @change.Text</strong> <small>@ChangeTitle(change)</small></li> }</ul>
        </details>
    }
}
@code {
    [Parameter] public SessionDetailDto? Detail { get; set; }
    private static string ChangeTitle(WordChangeDto c) => $"{c.CreatedAt.ToOffset(TimeSpan.FromHours(3)):dd.MM.yyyy HH:mm} · {(c.Source == "session" ? "Oturum" : "Atanmış Kelimeler")}";
}
