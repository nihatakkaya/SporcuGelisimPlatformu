<div class="section-title-row">
    <h3><a href="@SessionUrl">Oturumlar</a></h3>
    <span>Toplam @Count oturum</span>
</div>
<p class="muted-line">Son oturum: <strong>@(LastSessionDate?.ToOffset(TimeSpan.FromHours(3)).ToString("dd.MM.yyyy") ?? "Henüz oturum yok")</strong></p>
<a class="btn btn-outline-primary btn-sm" href="@SessionUrl">Oturumları Gör →</a>

@code {
    [Parameter] public Guid AthleteId { get; set; }
    [Parameter] public int Count { get; set; }
    [Parameter] public DateTimeOffset? LastSessionDate { get; set; }
    private string SessionUrl => $"/coach/athletes/{AthleteId}/sessions";
}
